{
  "name": "beauty-wholesale-admin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode test",
    "dev:mock": "vite --mode mock",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode test && node scripts/verify-real-build.mjs",
    "build:mock": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode mock",
    "verify:real-build": "node scripts/verify-real-build.mjs",
    "preview": "vite preview --mode test"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "echarts": "^5.6.0",
    "element-plus": "^2.11.4",
    "lucide-vue-next": "^0.544.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "unplugin-element-plus": "^0.10.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
