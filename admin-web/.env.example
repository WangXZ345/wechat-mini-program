# real 是默认模式；缺少环境 ID 或 API 地址时会拒绝启动/构建。
# ADMIN_WEB_BFF_PROXY_TARGET / ADMIN_WEB_BFF_PROXY_ORIGIN / ADMIN_WEB_ACTION_SECRET
# 是开发服务器私有配置，只能通过服务端环境变量提供，不得改成 VITE_*。
VITE_APP_ENV=test
VITE_DATA_MODE=real
VITE_CLOUDBASE_ENV_ID=
VITE_API_BASE_URL=/api/admin/v1
VITE_REQUEST_TIMEOUT_MS=12000
VITE_REALTIME_MODE=polling
VITE_RELEASE=test-local
