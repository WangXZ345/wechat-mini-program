.detail-layout {
  display: block;
}

.detail-left-column,
.detail-right-column {
  min-width: 0;
}

.page.page-safe-bottom {
  padding-bottom: 190rpx;
  padding-bottom: calc(190rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.detail-page-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  margin: 4rpx 0 20rpx;
}

.detail-heading-copy {
  flex: 1;
  min-width: 0;
}

.detail-page-eyebrow {
  color: #8A6A43;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}

.detail-page-title {
  margin-top: 8rpx;
  color: #1F1A15;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: 0;
  display: -webkit-box;
  overflow: hidden;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.detail-page-subtitle {
  margin-top: 10rpx;
  color: rgba(31, 26, 21, 0.60);
  font-size: 25rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-hero-shell {
  position: relative;
  margin-bottom: 18rpx;
  border-radius: 34rpx;
  overflow: hidden;
  border: 1rpx solid rgba(230, 216, 199, 0.82);
  box-shadow: 0 14rpx 36rpx rgba(142, 116, 86, 0.12);
  background: linear-gradient(135deg, #EFE6DA, #E6D8C7);
}

.hero {
  width: 100%;
  height: 360rpx;
  border-radius: 0;
  background: #E6D8C7;
  margin-bottom: 0;
  display: block;
}

.hero-badge-row {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  box-sizing: border-box;
}

.hero-badge {
  max-width: 360rpx;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.88);
  color: #6D5233;
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(86, 62, 34, 0.10);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-badge-warning {
  background: rgba(246, 229, 222, 0.92);
  color: #8A4A36;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #BBAA96;
}

.desc {
  margin-top: 20rpx;
  line-height: 1.7;
  color: #82776B;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tag-product {
  border: 0;
  font-size: 22rpx;
  line-height: 36rpx;
  height: 36rpx;
  padding: 0 14rpx;
}

.tag-new {
  background: #F3E7D2;
  color: #7B5C2E;
}

.tag-defective {
  background: #E7DED5;
  color: #645342;
}

.tag-hot {
  background: #F2E0D0;
  color: #7A4D2C;
}

.tag-frequent {
  background: #E4EAEC;
  color: #4D6067;
}

.defect-box {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid #DCCFC2;
  background: #F4EDE5;
}

.defect-title {
  color: #645342;
  font-size: 26rpx;
  font-weight: 800;
}

.defect-content {
  margin-top: 8rpx;
  color: #7B6A5A;
  font-size: 25rpx;
  line-height: 1.6;
}

.title-row,
.detail-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.detail-eyebrow {
  margin-bottom: 8rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 800;
}

.product-title {
  flex: 1;
  min-width: 0;
}

.detail-favorite {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 0 0 58rpx;
  width: 58rpx;
  min-width: 58rpx;
  height: 58rpx;
  line-height: 1;
  border-radius: 999rpx;
  border: 2rpx solid rgba(185, 156, 116, 0.88);
  background: #FFFCF7;
  color: #7B6245;
  font-size: 30rpx;
  font-weight: 700;
  margin: 0;
  padding: 0;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(86, 62, 34, 0.1);
}

.detail-favorite::after {
  border: 0;
}

.detail-favorite.active {
  color: #FFFFFF;
  border-color: #B99C74;
  background: #B99C74;
}

.detail-price-note {
  flex: 0 0 auto;
  min-width: 68rpx;
  height: 42rpx;
  line-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #F3E7D6;
  color: #8A6A43;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.purchase-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.purchase-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.4;
}

.detail-qty-stepper {
  display: inline-flex;
  flex-shrink: 0;
}

.total {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.action-btn {
  flex: 1;
}

.detail-add-cart-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  height: 76rpx;
  line-height: 1;
  border-radius: 999rpx;
  border: 1rpx solid #DFC8A8;
  background: linear-gradient(180deg, #F5E9DA 0%, #E8D6BD 100%);
  box-shadow: 0 8rpx 22rpx rgba(120, 95, 62, 0.10);
  color: #74532E;
  font-size: 26rpx;
  font-weight: 600;
  margin: 0;
  padding: 0 30rpx;
  transition: transform 0.12s ease, opacity 0.12s ease, background 0.12s ease;
}

.detail-add-cart-btn::after {
  border: 0;
}

.detail-add-cart-btn:active {
  transform: scale(0.97);
  opacity: 0.86;
  background: #E8D7BF;
}

.detail-add-cart-btn[disabled] {
  opacity: 0.68;
}

.detail-add-cart-btn .plus {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  line-height: 1;
  font-size: 30rpx;
  font-weight: 600;
  transform: translateY(-1rpx);
}

.cart-link {
  width: 100%;
}

.delivery-options {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.delivery-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 58rpx;
  padding: 0 18rpx;
  border: 1rpx solid #E6D8C7;
  border-radius: 999rpx;
  background: #FFFCF7;
  box-sizing: border-box;
}

.delivery-option.selected {
  border-color: #B99C74;
  background: #F3E7D6;
}

.delivery-panel {
  margin-top: 16rpx;
  padding-top: 8rpx;
}

.field {
  margin-top: 16rpx;
}

.label {
  margin-bottom: 8rpx;
  color: #82776B;
  font-size: 24rpx;
  font-weight: 600;
}

.kv {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EFE6DA;
}

.kv text:last-child {
  max-width: 460rpx;
  text-align: right;
}

.block {
  display: block;
  margin-top: 12rpx;
}

.selected-address,
.empty-address {
  padding: 18rpx;
  border: 1rpx solid #E6D8C7;
  border-radius: 22rpx;
  background: #FFFCF7;
}

.receiver {
  font-size: 28rpx;
  font-weight: 700;
}

.address-text {
  margin-top: 10rpx;
  line-height: 1.6;
  word-break: break-all;
}

.address-btn {
  width: 100%;
  margin-top: 16rpx;
}

.detail-price {
  font-size: 46rpx;
  line-height: 1.08;
}

.detail-info-card,
.detail-purchase-card,
.delivery-detail-card {
  border-radius: 30rpx;
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
}

.detail-info-card {
  padding-top: 24rpx;
}

.detail-purchase-card,
.delivery-detail-card {
  box-shadow: var(--shadow-soft);
  padding: 22rpx;
}

.spec {
  margin-top: 10rpx;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.meta-item {
  padding: 14rpx;
  border-radius: 16rpx;
  background: #FFFCF7;
  color: #82776B;
  font-size: 22rpx;
}

.meta-item text {
  display: block;
}

.meta-item text:last-child {
  margin-top: 8rpx;
  color: #1F1A15;
  font-weight: 700;
  word-break: break-all;
}

.detail-footer {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  bottom: calc(20rpx + constant(safe-area-inset-bottom));
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.82);
  border-radius: 36rpx;
  background: rgba(255, 253, 249, 0.94);
  box-shadow: 0 18rpx 46rpx rgba(64, 48, 30, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
  z-index: 30;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  animation: detail-footer-rise 0.22s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.detail-footer .action-btn,
.detail-footer .btn-primary {
  height: 70rpx;
  line-height: 70rpx;
}

@keyframes detail-footer-rise {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==================== 横屏适配 ==================== */

.is-landscape .detail-footer {
  left: calc(48rpx + constant(safe-area-inset-left));
  left: calc(48rpx + env(safe-area-inset-left));
  right: calc(48rpx + constant(safe-area-inset-right));
  right: calc(48rpx + env(safe-area-inset-right));
  bottom: 18rpx;
  bottom: calc(18rpx + constant(safe-area-inset-bottom));
  bottom: calc(18rpx + env(safe-area-inset-bottom));
}

.is-wide .detail-footer {
  max-width: 1120rpx;
  left: 50%;
  right: auto;
  width: calc(100% - 96rpx);
  animation: detail-footer-rise-wide 0.22s cubic-bezier(0.22, 1, 0.36, 1) both;
  transform: translateX(-50%);
}

@keyframes detail-footer-rise-wide {
  from {
    opacity: 0;
    transform: translate(-50%, 24rpx);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

.is-landscape .detail-layout,
.is-wide .detail-layout {
  display: grid;
  grid-template-columns: minmax(340rpx, 0.9fr) minmax(0, 1.1fr);
  gap: 24rpx;
  align-items: start;
}

.product-detail-page.is-landscape .detail-page-heading,
.product-detail-page.is-wide .detail-page-heading {
  margin-bottom: 18rpx;
}

.is-landscape .detail-left-column,
.is-wide .detail-left-column {
  position: sticky;
  top: 24rpx;
}

.product-detail-page.is-landscape .detail-right-column,
.product-detail-page.is-wide .detail-right-column {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.product-detail-page.is-landscape .detail-right-column .section,
.product-detail-page.is-wide .detail-right-column .section {
  margin-bottom: 0;
}

.is-landscape .detail-hero-shell,
.is-wide .detail-hero-shell {
  margin-bottom: 0;
}

.product-detail-page.is-landscape .hero {
  height: 500rpx;
}

.product-detail-page.is-wide .hero {
  height: 560rpx;
}

.product-detail-page.is-landscape .detail-info-card,
.product-detail-page.is-wide .detail-info-card,
.product-detail-page.is-landscape .detail-purchase-card,
.product-detail-page.is-wide .detail-purchase-card,
.product-detail-page.is-landscape .delivery-detail-card,
.product-detail-page.is-wide .delivery-detail-card {
  border-radius: 28rpx;
}

.is-wide .detail-layout {
  grid-template-columns: minmax(420rpx, 0.85fr) minmax(0, 1.15fr);
}

.is-landscape .meta-grid,
.is-wide .meta-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.is-landscape .delivery-options,
.is-wide .delivery-options {
  gap: 14rpx;
}

.is-landscape .delivery-option,
.is-wide .delivery-option {
  flex: 1 1 220rpx;
  justify-content: center;
}

@media (max-width: 360px) {
  .purchase-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .detail-qty-stepper {
    width: 100%;
    justify-content: center;
  }
}
