.order-list-page {
  --color-text-secondary: #74695E;
  --color-text-muted: #786E64;
  background: var(--color-bg);
}

.order-list-page .tag-muted {
  color: #62564A;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 104rpx;
  padding: 24rpx 0 16rpx;
}

.order-title-line {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  min-width: 0;
}

.order-title-line .page-title {
  color: var(--color-text-main);
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.12;
  letter-spacing: 0;
}

.order-inline-count {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.order-search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.order-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: 18rpx;
  background: var(--color-card);
  color: var(--color-text-main);
  font-size: 25rpx;
  box-sizing: border-box;
}

.order-filter-trigger {
  flex-shrink: 0;
  min-width: 120rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: 18rpx;
  background: var(--color-card);
  color: var(--color-text-main);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 70rpx;
  box-sizing: border-box;
}

.order-filter-trigger::after,
.clear-filter-button::after,
.filter-close-button::after {
  border: 0;
}

.order-filter-trigger.active {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #FFFFFF;
}

.order-filter-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  margin-left: 6rpx;
  padding: 0 5rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.22);
  font-size: 20rpx;
  line-height: 30rpx;
  box-sizing: border-box;
}

.active-filter-scroll {
  width: 100%;
  margin-bottom: 14rpx;
  white-space: nowrap;
}

.active-filter-track {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-width: 100%;
}

.active-filter-chip {
  flex-shrink: 0;
  max-width: 480rpx;
  overflow: hidden;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  background: rgba(53, 108, 246, 0.10);
  color: var(--color-primary-deep);
  font-size: 22rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.clear-filter-button {
  flex-shrink: 0;
  min-width: 76rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 56rpx;
}

.order-filter-scroll {
  width: calc(100% + 48rpx);
  height: 90rpx;
  margin: 0 -24rpx 22rpx;
  white-space: nowrap;
  border-bottom: 1rpx solid var(--color-border-light);
  box-sizing: border-box;
}

.order-filter-track {
  display: inline-flex;
  align-items: stretch;
  gap: 34rpx;
  min-width: 100%;
  height: 89rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.order-filter-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 72rpx;
  min-height: 88rpx;
  padding: 0 4rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.2;
  box-sizing: border-box;
}

.order-filter-tab.active {
  color: var(--color-text-main);
  font-weight: 800;
}

.order-filter-label {
  white-space: nowrap;
}

.order-filter-indicator {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 36rpx;
  height: 5rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  opacity: 0;
  transform: translateX(-50%);
}

.order-filter-tab.active .order-filter-indicator {
  opacity: 1;
}

.order {
  margin-bottom: 20rpx;
}

.order-card-modern {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 24rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  border-color: rgba(230, 216, 199, 0.78);
  box-shadow: 0 8rpx 22rpx rgba(142, 116, 86, 0.07);
  box-sizing: border-box;
  transition: opacity var(--motion-press) var(--motion-ease-out), transform var(--motion-press) var(--motion-ease-out);
}

.order-grid {
  display: block;
}

.paid-order {
  border-color: #D7E3CC;
  background: var(--color-card);
}

.order-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.order-title-block {
  flex: 1;
  min-width: 0;
}

.order-status-tag {
  flex-shrink: 0;
  min-height: 44rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
  white-space: nowrap;
}

.order-title {
  max-width: none;
  margin-top: 6rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  color: var(--color-text-main);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.38;
  word-break: break-word;
}

.order-no {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
  word-break: break-all;
}

.order-summary-panel {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--color-border-light);
  border-bottom: 1rpx solid var(--color-border-light);
}

.order-summary-main {
  flex: 1;
  min-width: 0;
}

.summary-label {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
}

.amount {
  margin-top: 2rpx;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.order-summary-metrics {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 18rpx;
}

.summary-metric {
  min-width: 62rpx;
  text-align: center;
}

.summary-value {
  color: var(--color-text-main);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.summary-divider {
  width: 1rpx;
  height: 42rpx;
  background: var(--color-border-light);
}

.order-next-step {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.order-next-mark {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-top: 9rpx;
  border-radius: 50%;
  background: var(--color-primary-deep);
}

.next-step-review .order-next-mark,
.next-step-confirm .order-next-mark {
  background: var(--color-warning);
}

.next-step-payment .order-next-mark {
  background: var(--color-money);
}

.next-step-shipping .order-next-mark {
  background: var(--color-primary-active);
}

.next-step-done .order-next-mark {
  background: var(--color-success);
}

.next-step-muted .order-next-mark {
  background: var(--color-text-muted);
}

.order-next-copy {
  flex: 1;
  min-width: 0;
}

.order-next-label {
  color: var(--color-text-secondary);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.2;
}

.order-next-title {
  margin-top: 2rpx;
  color: var(--color-text-main);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.order-next-hint {
  margin-top: 2rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.45;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
  word-break: break-word;
}

.order-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: auto;
  padding-top: 16rpx;
}

.payment-tag {
  max-width: 380rpx;
  min-width: 0;
  line-height: 1.3;
}

.detail-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  min-height: 56rpx;
  padding: 0 4rpx 0 18rpx;
  color: var(--color-text-main);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.merge-info {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #EAD8BF;
  border-radius: var(--radius-md);
  background: var(--color-warning-bg);
}

.merge-title {
  color: var(--color-warning-text);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.merge-info .muted {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.4;
  word-break: break-word;
}

.order-load-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.retry-btn {
  position: relative;
  flex-shrink: 0;
  width: 128rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0;
  font-size: 24rpx;
}

.retry-btn::before {
  content: "";
  position: absolute;
  inset: -16rpx 0;
}

.empty-clear-button {
  width: 240rpx;
  min-height: 72rpx;
  margin: 18rpx auto 28rpx;
  font-size: 24rpx;
  line-height: 70rpx;
}

.older-search-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 0;
  padding: 20rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: 18rpx;
  background: var(--color-card);
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
  box-sizing: border-box;
}

.older-search-button {
  min-width: 300rpx;
  min-height: 72rpx;
  margin: 0;
  font-size: 24rpx;
  line-height: 70rpx;
}

.filter-drawer-layer {
  position: fixed;
  z-index: 1000;
  inset: 0;
}

.filter-drawer-mask {
  position: absolute;
  inset: 0;
  background: rgba(26, 22, 18, 0.42);
}

.order-filter-drawer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 82vh;
  overflow-y: auto;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: var(--color-card);
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.filter-drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.filter-drawer-title {
  color: var(--color-text-main);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.filter-close-button {
  flex-shrink: 0;
  min-width: 96rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 64rpx;
}

.filter-section {
  margin-bottom: 26rpx;
}

.filter-section-title {
  margin-bottom: 14rpx;
  color: var(--color-text-main);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.4;
}

.filter-option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-option {
  min-width: 132rpx;
  min-height: 68rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: 16rpx;
  background: var(--color-card);
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 34rpx;
  text-align: center;
  box-sizing: border-box;
}

.filter-option.selected {
  border-color: var(--color-primary);
  background: rgba(53, 108, 246, 0.10);
  color: var(--color-primary-deep);
  font-weight: 700;
}

.custom-date-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.custom-date-row picker {
  flex: 1;
  min-width: 0;
}

.date-picker {
  min-height: 68rpx;
  overflow: hidden;
  padding: 16rpx 10rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: 14rpx;
  color: var(--color-text-main);
  font-size: 23rpx;
  line-height: 34rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.date-separator {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.filter-drawer-actions {
  position: sticky;
  bottom: 0;
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 16rpx;
  padding-top: 16rpx;
  background: var(--color-card);
}

.filter-drawer-actions .btn {
  width: 100%;
  min-width: 0;
  min-height: 76rpx;
  margin: 0;
  font-size: 25rpx;
  line-height: 74rpx;
}

.order-list-page.is-landscape .order-header {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.order-list-page.is-landscape .order-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.order-list-page.is-landscape .order {
  min-height: 356rpx;
  margin-bottom: 0;
}

.order-list-page.is-landscape .order-title {
  max-width: none;
}

.order-list-page.is-wide .order-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.order-list-page.is-wide .order {
  min-height: 356rpx;
  margin-bottom: 0;
}

.order-list-page.is-landscape .order-summary-panel,
.order-list-page.is-wide .order-summary-panel {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.order-list-page.is-landscape .order-summary-metrics,
.order-list-page.is-wide .order-summary-metrics {
  justify-content: flex-start;
}

.order-list-page.is-landscape .summary-metric,
.order-list-page.is-wide .summary-metric {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-width: 0;
  text-align: left;
}

@media (max-width: 360px) {
  .order-search-row {
    gap: 10rpx;
  }

  .order-search-input {
    padding: 0 16rpx;
    font-size: 23rpx;
  }

  .order-filter-trigger {
    min-width: 108rpx;
    padding: 0 12rpx;
  }

  .filter-option {
    min-width: calc(50% - 6rpx);
  }

  .order-filter-track {
    gap: 28rpx;
  }

  .order-card-modern {
    padding: 20rpx;
  }

  .order-card-head,
  .order-summary-panel,
  .order-action-row {
    gap: 12rpx;
  }

  .order-summary-metrics {
    gap: 10rpx;
  }

  .summary-metric {
    min-width: 54rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .order-list-page,
  .order-list-page .fade-up,
  .order-card-modern {
    animation: none !important;
    transition: none !important;
  }
}
