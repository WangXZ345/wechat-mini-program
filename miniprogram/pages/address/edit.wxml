<view class="page address-edit-page page-enter page-safe-bottom">
  <view class="address-edit-hero section">
    <view>
      <view class="section-kicker">配送信息</view>
      <view class="page-title">{{id ? '编辑地址' : '新增地址'}}</view>
      <view class="page-desc">用于订单配送、发货核对和售后处理。</view>
    </view>
    <view wx:if="{{selectMode}}" class="mode-pill">本次订单</view>
  </view>

  <ui-skeleton wx:if="{{loading}}" count="{{3}}" showThumb="{{false}}"></ui-skeleton>

  <block wx:if="{{!loading}}">
    <view class="card section address-form-card">
      <view class="form-card-head">
        <view>
          <view class="section-title">收货人信息</view>
          <view class="form-desc">请填写可联系到的收货信息</view>
        </view>
      </view>
      <view class="field">
        <view class="label">收货人</view>
        <input class="input" placeholder="请填写收货人" value="{{form.receiverName}}" data-field="receiverName" bindinput="onInput"></input>
      </view>

      <view class="field">
        <view class="label">手机号</view>
        <input class="input" type="number" maxlength="11" placeholder="请填写手机号" value="{{form.receiverPhone}}" data-field="receiverPhone" bindinput="onInput"></input>
      </view>

      <view class="field">
        <view class="label">省市区</view>
        <picker mode="region" value="{{form.region}}" bindchange="onRegionChange">
          <view class="input picker-value">{{form.regionText || '请选择省市区'}}</view>
        </picker>
      </view>

      <view class="field">
        <view class="label">详细地址</view>
        <textarea class="textarea" maxlength="200" placeholder="街道、门牌号等，至少 5 个字" value="{{form.detailAddress}}" data-field="detailAddress" bindinput="onInput"></textarea>
      </view>

      <view class="field">
        <view class="label">地址标签</view>
        <input class="input" maxlength="10" placeholder="可选，例如：家 / 公司 / 仓库" value="{{form.addressTag}}" data-field="addressTag" bindinput="onInput"></input>
      </view>

      <view class="row between switch-row">
        <view>
          <view class="label">默认地址</view>
          <view class="muted">下单时优先选中该地址</view>
        </view>
        <switch checked="{{form.isDefault}}" bindchange="onDefaultChange"></switch>
      </view>
    </view>

    <view class="section actions address-edit-actions">
      <button class="btn btn-primary action-full" loading="{{saving}}" bindtap="saveAddress">保存地址</button>
      <button wx:if="{{id && !form.isDefault}}" class="btn btn-secondary action-full" bindtap="setDefault">设为默认地址</button>
      <button wx:if="{{id}}" class="btn btn-danger action-full" bindtap="deleteAddress">删除地址</button>
    </view>
  </block>
</view>
