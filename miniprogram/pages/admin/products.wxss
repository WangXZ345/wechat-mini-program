.products-page {
  padding-bottom: 56rpx;
}

.products-hero {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 32rpx 24rpx;
  margin: -24rpx -24rpx 24rpx;
  border-radius: 0 0 36rpx 36rpx;
  background:
    radial-gradient(circle at 88% 0, rgba(255, 253, 249, 0.34), rgba(255, 253, 249, 0) 260rpx),
    linear-gradient(135deg, #C7AE8B, #9A856B);
  box-shadow: 0 12rpx 30rpx rgba(142, 116, 86, 0.14);
}

.products-hero-copy {
  min-width: 0;
}

.eyebrow,
.section-kicker {
  color: rgba(31, 26, 21, 0.58);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.eyebrow {
  margin-bottom: 8rpx;
}

.products-title {
  color: #1F1A15;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: 0;
  white-space: normal;
  word-break: keep-all;
}

.products-subtitle {
  margin-top: 8rpx;
  color: rgba(31, 26, 21, 0.68);
  font-size: 26rpx;
  line-height: 1.45;
}

.products-hero-panel {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  overflow-x: auto;
}

.hero-metric {
  flex: 1;
  min-width: 150rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 253, 249, 0.52);
  border-radius: 24rpx;
  background: rgba(255, 253, 249, 0.54);
  box-sizing: border-box;
}

.hero-value {
  color: #1F1A15;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.1;
}

.hero-label {
  margin-top: 6rpx;
  color: rgba(31, 26, 21, 0.66);
  font-size: 22rpx;
  font-weight: 700;
}

.hero-filter-pill,
.filter-summary-pill {
  flex-shrink: 0;
  max-width: 360rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.72);
  color: #5D4528;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 76rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.filter-summary-pill {
  max-width: 320rpx;
  min-height: 50rpx;
  background: var(--color-tag-bg);
  color: var(--color-tag-text);
  font-size: 23rpx;
  line-height: 50rpx;
}

.hero-action {
  width: 160rpx;
}

.product-form-card,
.product-control-card,
.product-batch-card,
.admin-product-card {
  border-color: rgba(230, 216, 199, 0.82);
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 8rpx;
}

.panel-note {
  max-width: 320rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: right;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 16rpx;
}

.input {
  margin-top: 0;
}

.area {
  height: 160rpx;
  padding-top: 18rpx;
}

.small-area {
  height: 120rpx;
}

.form-wide {
  min-width: 0;
}

.form-switches {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.active {
  gap: 10rpx;
  margin: 0;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.72);
  color: #5D4528;
  font-size: 24rpx;
  font-weight: 700;
}

.form-submit {
  margin-top: 4rpx;
}

.tag-editor {
  padding: 18rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.72);
  border-radius: 22rpx;
  background: rgba(255, 253, 249, 0.68);
}

.tag-checks,
.batch-tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tag-check {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid #E6D8C7;
  border-radius: 999rpx;
  background: #FFFDF9;
  font-size: 24rpx;
  color: #7B6245;
}

.search-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  align-items: center;
}

.search-input {
  flex: 0 0 100%;
  width: 100%;
  box-sizing: border-box;
}

.search-btn,
.clear-btn {
  flex: 1;
  width: auto;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 24rpx;
  margin: 0;
  padding: 0;
}

.search-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.filter-label,
.tool-title {
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 800;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-bottom: 4rpx;
  overflow-x: auto;
}

.filter-btn {
  flex: 0 0 auto;
  width: auto;
  min-width: 136rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #E6D8C7;
  border-radius: 999rpx;
  background: #FFFDF9;
  color: #82776B;
  font-size: 24rpx;
}

.active-filter {
  border-color: var(--color-primary);
  background: linear-gradient(180deg, #F7ECDA, var(--color-tag-bg));
  color: #5D4528;
  font-weight: 800;
  box-shadow: var(--shadow-soft);
}

.product-control-card > .input {
  margin-top: 16rpx;
}

.batch-row {
  gap: 16rpx;
  flex-wrap: wrap;
}

.batch-btn {
  flex: 1;
  min-width: 220rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}

.batch-price {
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.72);
  border-radius: 24rpx;
  background: rgba(255, 253, 249, 0.66);
}

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin: 12rpx 0;
  font-size: 24rpx;
}

.tag-batch-btn {
  flex: 1;
  min-width: 188rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 23rpx;
  margin: 0;
  padding: 0;
}

.small-subtitle {
  font-size: 26rpx;
}

.index-btn {
  display: block;
  margin: 18rpx auto 0;
  width: 432rpx;
  max-width: 100%;
  min-height: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  font-size: 25rpx;
  white-space: nowrap;
}

.products-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 28rpx 2rpx 18rpx;
}

.section-title {
  margin-top: 4rpx;
  color: var(--color-text-main);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.18;
}

.products-section-note {
  flex-shrink: 0;
  max-width: 300rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
}

.product {
  margin-bottom: 20rpx;
}

.admin-product-card {
  position: relative;
  overflow: hidden;
  padding-top: 28rpx;
  border-radius: 32rpx;
}

.product-card-accent {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 8rpx;
  background: linear-gradient(90deg, #C7AE8B, rgba(199, 174, 139, 0.18));
}

.product-card-header {
  gap: 14rpx;
  align-items: flex-start;
}

.select-label {
  flex: 1;
  gap: 12rpx;
  min-width: 0;
  align-items: center;
}

.product-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  background: #EFE6DA;
  flex-shrink: 0;
}

.product-thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8A6A43;
  font-size: 34rpx;
  font-weight: 900;
}

.product-title-block {
  min-width: 0;
}

.product-name {
  min-width: 0;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-index {
  margin-top: 8rpx;
  line-height: 1.35;
  word-break: break-all;
}

.product-status {
  flex-shrink: 0;
}

.product-status-on {
  background: var(--color-success-bg);
  color: var(--color-success-text);
}

.product-status-off {
  background: var(--color-danger-bg);
  color: var(--color-danger-text);
}

.product-meta-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.info-panel {
  min-width: 0;
  padding: 16rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.72);
  border-radius: 22rpx;
  background: rgba(255, 253, 249, 0.68);
}

.info-label {
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.info-main {
  margin-top: 6rpx;
  color: var(--color-text-main);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
  word-break: break-all;
}

.info-sub,
.defect-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.product-price-panel {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 234, 0.82);
  border: 1rpx solid rgba(230, 216, 199, 0.72);
}

.price-main {
  color: var(--color-money);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.stock-stack {
  flex-shrink: 0;
  min-width: 170rpx;
  text-align: right;
}

.stock-number {
  color: var(--color-text-main);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.stock-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  background: #EFE6DA;
  color: #82776B;
}

.stock-status.warning {
  background: #F3E7D6;
  color: #8A6A43;
}

.stock-status.out_of_stock {
  background: #F6E5DE;
  color: #9A2D2D;
}

.price-edit {
  gap: 12rpx;
  margin-top: 16rpx;
}

.price-input {
  flex: 1;
  min-width: 0;
}

.price-btn {
  width: 180rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 24rpx;
  margin: 0;
  padding: 0;
}

.actions {
  gap: 16rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.small {
  flex: 1;
  min-width: 160rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
}

.mini {
  width: 132rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  margin: 0;
}

.small-empty {
  padding: 28rpx 24rpx;
  font-size: 24rpx;
}

.admin-responsive-page.is-landscape .products-hero {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
}

.admin-responsive-page.is-landscape .products-hero-copy {
  flex: 1 1 320rpx;
}

.admin-responsive-page.is-landscape .products-hero-panel {
  flex: 1 1 460rpx;
}

.admin-responsive-page.is-landscape .hero-action {
  flex: 0 0 150rpx;
}

.admin-responsive-page.is-landscape .form-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.admin-responsive-page.is-landscape .form-wide,
.admin-responsive-page.is-landscape .tag-editor {
  grid-column: 1 / -1;
}

.admin-responsive-page.is-landscape .search-row {
  flex-wrap: nowrap;
}

.admin-responsive-page.is-landscape .search-input {
  flex: 1 1 auto;
  width: auto;
}

.admin-responsive-page.is-landscape .search-btn,
.admin-responsive-page.is-landscape .clear-btn {
  flex: 0 0 160rpx;
}

.admin-responsive-page.is-landscape .batch-row,
.admin-responsive-page.is-landscape .price-edit,
.admin-responsive-page.is-landscape .actions {
  flex-wrap: nowrap;
}

.admin-responsive-page.is-landscape .product-list-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.admin-responsive-page.is-landscape .product {
  margin-bottom: 0;
  min-width: 0;
}

.admin-responsive-page.is-landscape .product-meta-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.admin-responsive-page.is-wide .product-list-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
