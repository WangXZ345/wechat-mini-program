.legacy-accounts-page {
  background: #F8F4ED;
}

.accounts-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding-top: 10rpx;
  margin-bottom: 18rpx;
}

.hero-kicker {
  color: #8A6A43;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-title {
  margin-top: 8rpx;
  color: #1F1A15;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.08;
}

.hero-desc {
  margin-top: 10rpx;
  color: #82776B;
  font-size: 24rpx;
  line-height: 1.5;
}

.refresh-btn {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 62rpx;
  line-height: 62rpx;
  margin: 4rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.account,
.empty-panel {
  border: 1rpx solid rgba(230, 216, 199, 0.92);
  border-radius: 28rpx;
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
  box-shadow: 0 10rpx 24rpx rgba(86, 62, 34, 0.07);
}

.empty-panel {
  padding: 28rpx 24rpx;
  color: #82776B;
  font-size: 24rpx;
  text-align: center;
}

.account {
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.account-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.account-title {
  flex: 1;
  min-width: 0;
  color: #1F1A15;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.account-pill {
  flex: 0 0 auto;
  height: 42rpx;
  line-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #F3E7D6;
  color: #8A6A43;
  font-size: 21rpx;
  font-weight: 800;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.metric-cell {
  min-width: 0;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  border: 1rpx solid #EFE6DA;
  background: #F8F1E8;
}

.metric-cell.primary {
  background: #FFF7EA;
}

.metric-label {
  display: block;
  color: #A79B8B;
  font-size: 21rpx;
}

.metric-value {
  display: block;
  margin-top: 6rpx;
  color: #1F1A15;
  font-size: 25rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mark-btn {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

@media (min-width: 700px) {
  .metric-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
