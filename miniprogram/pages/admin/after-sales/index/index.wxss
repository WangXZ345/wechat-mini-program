.after-sales-page {
  padding-bottom: 56rpx;
}

.after-hero {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  justify-content: space-between;
  padding: 32rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.92);
  border-radius: var(--radius-xxl);
  background:
    linear-gradient(135deg, rgba(255, 253, 249, 0.88), rgba(255, 253, 249, 0) 58%),
    linear-gradient(160deg, #FFFDF9 0%, #F3E7D6 100%);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.hero-copy {
  min-width: 0;
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-tag-bg);
  color: var(--color-tag-text);
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 16rpx;
  color: var(--color-text-main);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.12;
}

.hero-desc {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-action {
  flex: 0 0 164rpx;
  width: 164rpx;
}

.filter-panel {
  position: relative;
}

.filter-summary {
  display: flex;
  gap: 18rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.filter-summary .muted,
.queue-title .muted {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.filter-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

.search-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.filter-picker,
.search-input {
  min-height: 72rpx;
  line-height: 72rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-search-bg);
  color: var(--color-text-main);
}

.filter-picker {
  width: 100%;
  font-weight: 800;
}

.search-input {
  flex: 1;
  min-width: 0;
}

.mini-btn {
  min-width: 112rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 700;
  background: var(--color-secondary-bg);
  color: var(--color-tag-text);
}

.mini-btn::after {
  border: 0;
}

.search-btn {
  width: 116rpx;
  flex-shrink: 0;
}

.export-row {
  justify-content: flex-start;
  gap: 14rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.export-btn {
  width: 240rpx;
}

.queue-title {
  display: flex;
  gap: 18rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.after-card {
  position: relative;
  overflow: hidden;
}

.card-line {
  position: absolute;
  left: 0;
  top: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--color-primary-light), var(--color-primary-deep));
}

.after-head {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.after-no {
  word-break: break-all;
}

.order-no,
.created {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.review-badge,
.risk-badge {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 23rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.review-badge {
  color: #7A4E00;
  background: #FFF0C2;
}

.risk-badge {
  color: var(--color-danger-text);
  background: var(--color-danger-bg);
}

.tag-warning {
  color: #7A4E00;
  background: #FFF0C2;
}

.customer-line {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-search-bg);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.metric-box {
  min-height: 94rpx;
  padding: 14rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-card-warm);
  box-sizing: border-box;
}

.metric-label {
  color: var(--color-text-muted);
  font-size: 22rpx;
  line-height: 1.35;
}

.metric-value {
  margin-top: 6rpx;
  color: var(--color-text-main);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.after-sales-page.is-landscape .filter-grid {
  grid-template-columns: 260rpx minmax(0, 1fr);
}

.after-sales-page.is-landscape .after-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 420rpx;
  gap: 16rpx 24rpx;
  align-items: start;
}

.after-sales-page.is-landscape .after-head,
.after-sales-page.is-landscape .badge-row,
.after-sales-page.is-landscape .customer-line,
.after-sales-page.is-landscape .created {
  grid-column: 1;
}

.after-sales-page.is-landscape .metric-grid {
  grid-column: 2;
  margin-top: 0;
}

@media (min-width: 1024px) {
  .after-sales-page .filter-grid {
    grid-template-columns: 280rpx minmax(0, 1fr);
  }

  .after-sales-page .after-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 440rpx;
    gap: 16rpx 24rpx;
  }

  .after-sales-page .after-head,
  .after-sales-page .badge-row,
  .after-sales-page .customer-line,
  .after-sales-page .created {
    grid-column: 1;
  }

  .after-sales-page .metric-grid {
    grid-column: 2;
    margin-top: 0;
  }
}
