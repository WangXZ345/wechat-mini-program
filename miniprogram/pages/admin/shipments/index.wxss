.shipments-page {
  padding-bottom: 56rpx;
}

.shipments-hero {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 32rpx 24rpx;
  margin: -24rpx -24rpx 24rpx;
  border-radius: 0 0 36rpx 36rpx;
  background:
    radial-gradient(circle at 88% 0, rgba(255, 253, 249, 0.34), rgba(255, 253, 249, 0) 260rpx),
    linear-gradient(135deg, #C7AE8B, #9A856B);
  box-shadow: 0 12rpx 30rpx rgba(142, 116, 86, 0.14);
}

.shipments-hero-copy {
  min-width: 0;
}

.eyebrow,
.section-kicker {
  color: rgba(31, 26, 21, 0.58);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.eyebrow {
  margin-bottom: 8rpx;
}

.shipments-title {
  color: #1F1A15;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: 0;
  white-space: normal;
  word-break: keep-all;
}

.shipments-subtitle {
  margin-top: 8rpx;
  color: rgba(31, 26, 21, 0.68);
  font-size: 26rpx;
  line-height: 1.45;
}

.shipments-hero-panel {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  overflow-x: auto;
}

.hero-metric {
  flex: 1;
  min-width: 150rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 253, 249, 0.52);
  border-radius: 24rpx;
  background: rgba(255, 253, 249, 0.54);
  box-sizing: border-box;
}

.hero-value {
  color: #1F1A15;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.1;
}

.hero-label {
  margin-top: 6rpx;
  color: rgba(31, 26, 21, 0.66);
  font-size: 22rpx;
  font-weight: 700;
}

.hero-filter-pill,
.filter-summary-pill {
  flex-shrink: 0;
  max-width: 360rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.72);
  color: #5D4528;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 76rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.filter-summary-pill {
  max-width: 320rpx;
  min-height: 50rpx;
  background: var(--color-tag-bg);
  color: var(--color-tag-text);
  font-size: 23rpx;
  line-height: 50rpx;
}

.hero-action {
  width: 160rpx;
}

.filter-card,
.shipment-card {
  border-color: rgba(230, 216, 199, 0.82);
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
}

.filter-card {
  margin-bottom: 24rpx;
}

.filter-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 4rpx;
}

.panel-title {
  margin-top: 4rpx;
  color: var(--color-text-main);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.search-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 16rpx;
}

.field {
  min-width: 0;
}

.label {
  margin-bottom: 8rpx;
  color: #82776B;
  font-size: 24rpx;
  font-weight: 700;
}

.picker-value {
  line-height: 76rpx;
}

.search-btn {
  width: 100%;
  margin: 0;
}

.mini {
  width: 132rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  margin: 0;
  padding: 0;
}

.shipments-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 28rpx 2rpx 18rpx;
}

.section-title {
  margin-top: 4rpx;
  color: var(--color-text-main);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.18;
}

.section-note {
  flex-shrink: 0;
  max-width: 320rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
}

.empty-desc {
  margin-top: 8rpx;
}

.shipment-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding-top: 28rpx;
  border-radius: 32rpx;
}

.shipment-card-accent {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 8rpx;
  background: linear-gradient(90deg, #C7AE8B, rgba(199, 174, 139, 0.18));
}

.shipment-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.shipment-title-block {
  min-width: 0;
}

.shipment-no {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shipment-customer,
.shipment-order-line {
  margin-top: 8rpx;
  line-height: 1.45;
  word-break: break-all;
}

.ship-tag {
  flex-shrink: 0;
  max-width: 180rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-created,
.status-pending_shipment {
  background: #F3E7D6;
  color: #8A6A43;
}

.status-shipped {
  background: #EAE2D5;
  color: #71583A;
}

.status-completed {
  background: #E9F0E1;
  color: #566F49;
}

.status-cancelled {
  background: #EFE6DA;
  color: #82776B;
}

.status-abnormal {
  background: #F6E5DE;
  color: #9A2D2D;
}

.shipment-metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.metric-panel {
  min-width: 0;
  padding: 16rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.72);
  border-radius: 22rpx;
  background: rgba(255, 253, 249, 0.68);
}

.metric-value {
  color: var(--color-text-main);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount-panel .metric-value {
  color: var(--color-money);
}

.date-value {
  font-size: 24rpx;
}

.metric-label {
  margin-top: 6rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 800;
}

.logistics-line {
  margin-top: 18rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.72);
  border-radius: 22rpx;
  background: rgba(255, 247, 234, 0.82);
}

.info-label {
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.logistics-text {
  margin-top: 8rpx;
  line-height: 1.45;
  word-break: break-all;
}

.load-more {
  width: 100%;
  margin: 20rpx 0 32rpx;
}

.shipments-page.is-landscape .shipments-hero {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
}

.shipments-page.is-landscape .shipments-hero-copy {
  flex: 1 1 320rpx;
}

.shipments-page.is-landscape .shipments-hero-panel {
  flex: 1 1 420rpx;
}

.shipments-page.is-landscape .hero-action {
  flex: 0 0 150rpx;
}

.shipments-page.is-landscape .filter-card {
  position: sticky;
  top: 0;
  z-index: 8;
}

.shipments-page.is-landscape .search-grid {
  grid-template-columns: minmax(0, 1fr) 260rpx 160rpx;
  align-items: end;
}

.shipments-page.is-landscape .search-btn {
  width: auto;
}

.shipments-page.is-landscape .shipment-list-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.shipments-page.is-landscape .shipment-card {
  min-width: 0;
  margin-bottom: 0;
}

.shipments-page.is-wide .shipment-list-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
