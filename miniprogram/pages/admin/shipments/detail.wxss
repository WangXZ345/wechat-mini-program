.shipment-detail-page {
  padding-bottom: 56rpx;
}

.detail-hero {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 32rpx 24rpx;
  margin: -24rpx -24rpx 24rpx;
  border-radius: 0 0 36rpx 36rpx;
  background:
    radial-gradient(circle at 88% 0, rgba(255, 253, 249, 0.34), rgba(255, 253, 249, 0) 260rpx),
    linear-gradient(135deg, #C7AE8B, #9A856B);
  box-shadow: 0 12rpx 30rpx rgba(142, 116, 86, 0.14);
}

.detail-hero-copy {
  min-width: 0;
}

.eyebrow,
.section-kicker {
  color: rgba(31, 26, 21, 0.58);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.eyebrow {
  margin-bottom: 8rpx;
}

.detail-title {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #1F1A15;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.16;
  letter-spacing: 0;
}

.detail-subtitle {
  margin-top: 8rpx;
  color: rgba(31, 26, 21, 0.68);
  font-size: 26rpx;
  line-height: 1.45;
}

.detail-hero-panel {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  overflow-x: auto;
}

.hero-metric {
  flex: 1;
  min-width: 150rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 253, 249, 0.52);
  border-radius: 24rpx;
  background: rgba(255, 253, 249, 0.54);
  box-sizing: border-box;
}

.amount-metric {
  min-width: 210rpx;
}

.hero-value {
  color: #1F1A15;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-label {
  margin-top: 6rpx;
  color: rgba(31, 26, 21, 0.66);
  font-size: 22rpx;
  font-weight: 700;
}

.hero-filter-pill,
.filter-summary-pill {
  flex-shrink: 0;
  max-width: 360rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.72);
  color: #5D4528;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 76rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.filter-summary-pill {
  max-width: 320rpx;
  min-height: 50rpx;
  background: var(--color-tag-bg);
  color: var(--color-tag-text);
  font-size: 23rpx;
  line-height: 50rpx;
}

.ship-tag {
  align-self: flex-start;
  max-width: 220rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-created,
.status-pending_shipment {
  background: #F3E7D6;
  color: #8A6A43;
}

.status-shipped {
  background: #EAE2D5;
  color: #71583A;
}

.status-completed {
  background: #E9F0E1;
  color: #566F49;
}

.status-cancelled {
  background: #EFE6DA;
  color: #82776B;
}

.status-abnormal {
  background: #F6E5DE;
  color: #9A2D2D;
}

.detail-panel {
  margin-bottom: 22rpx;
  border-color: rgba(230, 216, 199, 0.82);
  border-radius: 32rpx;
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.panel-title {
  margin-top: 4rpx;
  color: var(--color-text-main);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.info-panel {
  min-width: 0;
  padding: 16rpx;
  margin-top: 14rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.72);
  border-radius: 22rpx;
  background: rgba(255, 253, 249, 0.68);
}

.info-panel:first-of-type {
  margin-top: 0;
}

.info-label {
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.info-main {
  margin-top: 6rpx;
  color: var(--color-text-main);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
  word-break: break-all;
}

.info-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.address {
  line-height: 1.6;
}

.logistics-form-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.field {
  min-width: 0;
}

.label {
  margin-bottom: 8rpx;
  color: #82776B;
  font-size: 24rpx;
  font-weight: 700;
}

.area {
  min-height: 150rpx;
  padding-top: 18rpx;
  line-height: 1.55;
}

.actions {
  gap: 12rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.small {
  flex: 1;
  min-width: 160rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
}

.order-list,
.item-list {
  border-top: 1rpx solid #EFE6DA;
}

.order-row,
.item-row,
.log-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EFE6DA;
}

.order-row:last-child,
.item-row:last-child,
.log-row:last-child {
  border-bottom: 0;
}

.order-no,
.item-name,
.log-action {
  min-width: 0;
  color: var(--color-text-main);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
  word-break: break-all;
}

.order-amount,
.count {
  flex-shrink: 0;
  color: var(--color-money);
  font-size: 26rpx;
  font-weight: 900;
}

.order-meta,
.item-meta,
.log-remark {
  margin-top: 8rpx;
  line-height: 1.45;
  word-break: break-all;
}

.item-main-row {
  align-items: flex-start;
}

.export-box {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EFE6DA;
}

.small-empty {
  padding: 10rpx 0 4rpx;
}

.log-time {
  flex-shrink: 0;
  max-width: 280rpx;
  text-align: right;
}

.shipment-detail-page.is-landscape .detail-hero {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
}

.shipment-detail-page.is-landscape .detail-hero-copy {
  flex: 1 1 380rpx;
}

.shipment-detail-page.is-landscape .detail-hero > .ship-tag {
  order: 3;
}

.shipment-detail-page.is-landscape .detail-hero-panel {
  flex: 1 1 520rpx;
}

.shipment-detail-page.is-landscape .detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: 22rpx;
}

.shipment-detail-page.is-landscape .detail-grid .detail-panel {
  margin-bottom: 0;
}

.shipment-detail-page.is-landscape .logistics-form-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.shipment-detail-page.is-landscape .form-wide {
  grid-column: 1 / -1;
}

.shipment-detail-page.is-landscape .order-list,
.shipment-detail-page.is-landscape .item-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 24rpx;
}

.shipment-detail-page.is-landscape .actions {
  flex-wrap: nowrap;
}

.shipment-detail-page.is-wide .order-list,
.shipment-detail-page.is-wide .item-list {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
