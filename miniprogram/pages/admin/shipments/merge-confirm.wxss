.merge-confirm-page {
  background: #F8F4ED;
}

.merge-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding-top: 10rpx;
  margin-bottom: 18rpx;
}

.hero-kicker {
  color: #8A6A43;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-title {
  margin-top: 8rpx;
  color: #1F1A15;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.08;
}

.hero-desc,
.card-desc,
.cell-label,
.row-meta,
.address-text {
  color: #82776B;
  font-size: 23rpx;
  line-height: 1.45;
}

.hero-desc {
  margin-top: 10rpx;
}

.hero-pill,
.status-pill {
  flex: 0 0 auto;
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #F3E7D6;
  color: #8A6A43;
  font-size: 21rpx;
  font-weight: 800;
}

.status-pill.ok {
  background: #E8F6EF;
  color: #1F7A4D;
}

.status-pill.warning {
  background: #FFF7EA;
  color: #8A6A43;
}

.merge-warning {
  border-radius: 24rpx;
}

.warning-title {
  font-weight: 800;
}

.warning-line {
  margin-top: 8rpx;
}

.customer-card,
.address-card,
.orders-card,
.items-card {
  padding: 24rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.92);
  border-radius: 28rpx;
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
  box-shadow: 0 10rpx 24rpx rgba(86, 62, 34, 0.07);
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.card-head.compact {
  margin-bottom: 14rpx;
}

.section-title {
  color: #1F1A15;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.summary-grid,
.amount-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.summary-cell,
.amount-cell {
  min-width: 0;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  border: 1rpx solid #EFE6DA;
  background: #F8F1E8;
}

.amount-grid {
  margin-top: 12rpx;
}

.amount-cell {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  grid-column: span 2;
  color: #82776B;
  font-size: 23rpx;
}

.amount-cell text:last-child {
  color: #1F1A15;
  font-weight: 900;
}

.amount-cell.primary {
  background: #FFF7EA;
}

.cell-value {
  margin-top: 6rpx;
  color: #1F1A15;
  font-size: 25rpx;
  font-weight: 900;
}

.address-text {
  padding: 16rpx;
  border-radius: 18rpx;
  background: #F8F1E8;
}

.address-warning {
  margin-top: 16rpx;
}

.order-row,
.item-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EFE6DA;
}

.order-row:last-child,
.item-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.row-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.row-title,
.item-name {
  flex: 1;
  min-width: 0;
  color: #1F1A15;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.row-price,
.count {
  flex: 0 0 auto;
  color: #A8793A;
  font-size: 25rpx;
  font-weight: 900;
}

.row-meta {
  margin-top: 6rpx;
}

.action-full {
  width: 100%;
  height: 74rpx;
  line-height: 74rpx;
  margin: 2rpx 0 32rpx;
  border-radius: 999rpx;
}

@media (min-width: 700px) {
  .summary-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .amount-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .amount-cell {
    grid-column: auto;
  }
}
