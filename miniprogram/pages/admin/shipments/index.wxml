<view class="page admin-responsive-page shipments-page page-enter {{isLandscape ? 'is-landscape' : 'is-portrait'}} {{isWideScreen ? 'is-wide' : ''}}">
  <view class="shipments-hero">
    <view class="shipments-hero-copy">
      <view class="eyebrow">FULFILLMENT DESK</view>
      <view class="shipments-title">履约工作台</view>
      <view class="shipments-subtitle">统一管理多个订单共用的物流单</view>
    </view>
    <view class="shipments-hero-panel">
      <view class="hero-metric">
        <view class="hero-value">{{groups.length}}</view>
        <view class="hero-label">当前发货单</view>
      </view>
      <view class="hero-filter-pill">{{statusOptions[statusIndex].label}}</view>
    </view>
    <button class="btn btn-secondary mini hero-action" bindtap="goOrders">订单</button>
  </view>

  <view class="card filter-card">
    <view class="filter-card-head">
      <view>
        <view class="section-kicker">SEARCH</view>
        <view class="panel-title">筛选发货单</view>
      </view>
      <view class="filter-summary-pill">{{statusOptions[statusIndex].label}}</view>
    </view>
    <view class="search-grid">
      <view class="field search-field">
        <view class="label">搜索</view>
        <input class="input" value="{{keyword}}" bindinput="onKeyword" placeholder="发货单号 / 订单号 / 客户 / 快递单号"></input>
      </view>
      <view class="field status-field">
        <view class="label">状态</view>
        <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange">
          <view class="input picker-value">{{statusOptions[statusIndex].label}}</view>
        </picker>
      </view>
      <button class="btn btn-primary search-btn" bindtap="search">查询</button>
    </view>
  </view>

  <view class="shipments-section-heading">
    <view>
      <view class="section-kicker">SHIPMENT QUEUE</view>
      <view class="section-title">发货单队列</view>
    </view>
    <view class="section-note">点击卡片查看物流、商品和导出明细</view>
  </view>

  <view wx:if="{{loading && !groups.length}}" class="empty">加载中...</view>
  <view wx:elif="{{initialized && !groups.length}}" class="empty">
    <view class="ui-empty-title">暂无合并发货单</view>
    <view class="muted empty-desc">请调整筛选条件或在订单管理中创建合并发货</view>
  </view>

  <view class="shipment-list-grid">
    <view wx:for="{{groups}}" wx:key="_id" class="card shipment-card card-press" bindtap="goDetail" data-id="{{item._id}}">
      <view class="shipment-card-accent"></view>
      <view class="shipment-card-header">
        <view class="shipment-title-block">
          <view class="subtitle shipment-no">{{item.shipmentNo}}</view>
          <view class="muted shipment-customer">客户：{{item.customerName}} {{item.customerPhoneMasked}}</view>
        </view>
        <view class="ship-tag status-{{item.shippingStatus}}">{{item.statusText}}</view>
      </view>
      <view class="shipment-order-line muted">订单：{{item.orderNosText}}</view>
      <view class="shipment-metric-grid">
        <view class="metric-panel">
          <view class="metric-value">{{item.orderCount}}</view>
          <view class="metric-label">订单</view>
        </view>
        <view class="metric-panel">
          <view class="metric-value">{{item.totalItemCount}}</view>
          <view class="metric-label">件数</view>
        </view>
        <view class="metric-panel amount-panel">
          <view class="metric-value">¥{{item.totalOrderAmountText}}</view>
          <view class="metric-label">金额</view>
        </view>
        <view class="metric-panel">
          <view class="metric-value date-value">{{item.createdAtText}}</view>
          <view class="metric-label">创建</view>
        </view>
      </view>
      <view wx:if="{{item.shippingCompany || item.trackingNo}}" class="logistics-line">
        <view class="info-label">物流</view>
        <view class="muted logistics-text">{{item.shippingCompany}} {{item.trackingNo}}</view>
      </view>
    </view>
  </view>

  <button wx:if="{{hasMore}}" class="btn btn-secondary load-more" loading="{{loading}}" bindtap="loadMore">加载更多</button>
</view>
