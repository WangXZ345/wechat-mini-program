.accounts-page {
  padding-bottom: 56rpx;
}

.accounts-hero {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.92);
  border-radius: var(--radius-xxl);
  background:
    linear-gradient(135deg, rgba(255, 253, 249, 0.88), rgba(255, 253, 249, 0) 58%),
    linear-gradient(160deg, #FFFDF9 0%, #F3E7D6 100%);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.hero-copy {
  padding-right: 152rpx;
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-tag-bg);
  color: var(--color-tag-text);
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 16rpx;
  color: var(--color-text-main);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.12;
}

.hero-desc {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-refresh {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 132rpx;
}

.filter-summary {
  display: flex;
  gap: 18rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.filter-summary .muted,
.queue-title .muted {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.filter-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

.field {
  min-width: 0;
}

.label {
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.picker-value {
  margin-top: 10rpx;
  font-weight: 800;
}

.search-field .input {
  margin-top: 10rpx;
}

.search-action {
  align-self: end;
}

.empty-panel {
  padding: 64rpx 24rpx;
  color: var(--color-text-muted);
  text-align: center;
}

.queue-title {
  display: flex;
  gap: 18rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.account {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.card-line {
  position: absolute;
  left: 0;
  top: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--color-primary-light), var(--color-primary-deep));
}

.account-head {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.account-main {
  flex: 1;
  min-width: 0;
}

.account-title,
.id-line {
  word-break: break-all;
}

.phone-line,
.id-line,
.recent-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.risk {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-secondary-bg);
  color: var(--color-tag-text);
  font-size: 24rpx;
  font-weight: 800;
}

.risk.risky,
.risk.blocked {
  background: var(--color-danger-bg);
  color: var(--color-danger-text);
}

.risk.watch {
  background: var(--color-tag-bg);
  color: var(--color-tag-text);
}

.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.metric-box {
  min-height: 88rpx;
  padding: 14rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-card-warm);
  box-sizing: border-box;
}

.metric-box text:last-child {
  display: block;
  margin-top: 6rpx;
  color: var(--color-text-main);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.primary-metric {
  grid-column: 1 / -1;
  background: linear-gradient(180deg, #FFFDF9 0%, #F3E7D6 100%);
  border-color: rgba(185, 156, 116, 0.36);
}

.recent-line {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-search-bg);
  color: var(--color-text-secondary);
}

.remark {
  margin-top: 14rpx;
  padding: 16rpx;
  background: var(--color-search-bg);
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.actions {
  gap: 12rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.small {
  min-width: 128rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
}

.accounts-page.is-landscape .filter-grid {
  grid-template-columns: 220rpx 220rpx minmax(0, 1fr) 180rpx;
  align-items: end;
}

.accounts-page.is-landscape .account {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 460rpx;
  gap: 16rpx 24rpx;
}

.accounts-page.is-landscape .account-head,
.accounts-page.is-landscape .recent-line,
.accounts-page.is-landscape .remark,
.accounts-page.is-landscape .actions {
  grid-column: 1;
}

.accounts-page.is-landscape .metrics {
  grid-column: 2;
  margin-top: 0;
}

@media (min-width: 1024px) {
  .accounts-page .filter-grid {
    grid-template-columns: 240rpx 240rpx minmax(0, 1fr) 200rpx;
    align-items: end;
  }

  .accounts-page .account {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 500rpx;
    gap: 16rpx 24rpx;
  }

  .accounts-page .account-head,
  .accounts-page .recent-line,
  .accounts-page .remark,
  .accounts-page .actions {
    grid-column: 1;
  }

  .accounts-page .metrics {
    grid-column: 2;
    margin-top: 0;
  }
}
