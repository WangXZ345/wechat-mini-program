.import-history-page {
  padding-bottom: 56rpx;
}

.history-hero {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  justify-content: space-between;
  padding: 32rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.92);
  border-radius: var(--radius-xxl);
  background:
    linear-gradient(135deg, rgba(255, 253, 249, 0.88), rgba(255, 253, 249, 0) 58%),
    linear-gradient(160deg, #FFFDF9 0%, #F3E7D6 100%);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-tag-bg);
  color: var(--color-tag-text);
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 16rpx;
  color: var(--color-text-main);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.12;
}

.hero-desc {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-back {
  flex: 0 0 132rpx;
  width: 132rpx;
}

.history-list,
.history-detail {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20rpx;
}

.record,
.item,
.detail-summary {
  position: relative;
  overflow: hidden;
}

.record-status-line {
  position: absolute;
  left: 0;
  top: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--color-primary-light), var(--color-primary-deep));
}

.record-head {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.record-title,
.item-title {
  flex: 1;
  min-width: 0;
  color: var(--color-text-main);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.record-sub {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.record-mode {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mode-pill {
  min-height: 44rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-secondary-bg);
  color: var(--color-tag-text);
  font-size: 22rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.record-metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.metric-box {
  min-height: 94rpx;
  padding: 14rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-search-bg);
  box-sizing: border-box;
}

.metric-label {
  color: var(--color-text-muted);
  font-size: 22rpx;
  line-height: 1.35;
}

.metric-value {
  margin-top: 6rpx;
  color: var(--color-text-main);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.1;
}

.self-check {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-success-bg);
  color: var(--color-success-text);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.empty-panel {
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.empty-title {
  color: var(--color-text-main);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.empty-desc {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
}

.queue-title {
  display: flex;
  gap: 18rpx;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 0;
}

.queue-title .muted {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.raw-panel {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-search-bg);
}

.raw-line {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  min-width: 0;
}

.raw-label {
  flex: 0 0 116rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.45;
}

.raw-text {
  flex: 1;
  min-width: 0;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.item-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.item-field {
  min-height: 88rpx;
  padding: 14rpx;
  border-radius: var(--radius-md);
  background: var(--color-card-warm);
  box-sizing: border-box;
}

.field-label {
  color: var(--color-text-muted);
  font-size: 22rpx;
  line-height: 1.35;
}

.field-value {
  margin-top: 6rpx;
  color: var(--color-text-main);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.error,
.warning {
  margin-top: 16rpx;
}

@media (min-width: 700px) {
  .history-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .history-detail {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .history-detail .detail-summary,
  .history-detail .queue-title {
    grid-column: 1 / -1;
  }

  .raw-panel {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 1024px) {
  .history-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .history-detail {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
