.import-page {
  padding-bottom: 56rpx;
}

.import-hero {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.92);
  border-radius: var(--radius-xxl);
  background:
    linear-gradient(135deg, rgba(255, 253, 249, 0.86) 0%, rgba(255, 253, 249, 0) 58%),
    linear-gradient(160deg, #FFFDF9 0%, #F3E7D6 100%);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.import-hero::after {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -96rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(185, 156, 116, 0.20);
  background: rgba(255, 253, 249, 0.34);
}

.hero-main {
  position: relative;
  z-index: 1;
  padding-right: 150rpx;
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-tag-bg);
  color: var(--color-tag-text);
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 16rpx;
  color: var(--color-text-main);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.12;
}

.hero-desc {
  margin-top: 14rpx;
  max-width: 620rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-history {
  position: absolute;
  right: 28rpx;
  top: 32rpx;
  z-index: 2;
  width: 132rpx;
}

.hero-metrics {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 28rpx;
}

.hero-metric {
  min-height: 104rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.76);
  border-radius: var(--radius-lg);
  background: rgba(255, 253, 249, 0.72);
  box-sizing: border-box;
}

.metric-label {
  color: var(--color-text-muted);
  font-size: 22rpx;
  line-height: 1.35;
}

.metric-value {
  margin-top: 8rpx;
  color: var(--color-text-main);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.parse-message {
  margin-top: -8rpx;
  margin-bottom: 24rpx;
}

.import-action-card {
  display: flex;
  gap: 22rpx;
  align-items: center;
  justify-content: space-between;
}

.action-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.action-button {
  flex: 0 0 240rpx;
  width: 240rpx;
}

.import-workbench {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20rpx;
}

.upload-step-card,
.mode-card {
  position: relative;
  min-height: 300rpx;
  overflow: hidden;
}

.upload-step-card::before,
.mode-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--color-primary-light), var(--color-primary-deep));
}

.step-index {
  width: 64rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin-bottom: 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-secondary-bg);
  color: var(--color-tag-text);
  text-align: center;
  font-size: 22rpx;
  font-weight: 900;
}

.step-desc {
  min-height: 72rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.upload-button {
  margin-top: 24rpx;
}

.file-pill,
.empty-pill {
  margin-top: 18rpx;
  min-height: 54rpx;
  padding: 12rpx 18rpx;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  line-height: 1.35;
  word-break: break-all;
  box-sizing: border-box;
}

.file-pill {
  border: 1rpx solid rgba(185, 156, 116, 0.36);
  background: var(--color-tag-bg);
  color: var(--color-text-main);
  font-weight: 700;
}

.empty-pill {
  border: 1rpx dashed var(--color-border);
  background: var(--color-search-bg);
  color: var(--color-text-muted);
}

.picker {
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-search-bg);
  color: var(--color-text-main);
  box-sizing: border-box;
}

.mode-picker {
  margin-top: 24rpx;
  font-weight: 800;
}

.import-page.admin-responsive-page.is-landscape {
  display: block;
}

.import-page.is-landscape .hero-metrics {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.import-page.is-landscape .import-action-card {
  position: sticky;
  top: 24rpx;
  z-index: 5;
}

.import-page.is-landscape .import-workbench {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.import-page.is-landscape .upload-step-card,
.import-page.is-landscape .mode-card {
  min-height: 320rpx;
}

@media (min-width: 1024px) {
  .import-page .hero-metrics {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .import-page .import-workbench {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .import-page .upload-step-card,
  .import-page .mode-card {
    min-height: 340rpx;
  }
}
