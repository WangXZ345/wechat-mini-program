.import-preview-page {
  padding-bottom: 172rpx;
  padding-bottom: calc(172rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(172rpx + env(safe-area-inset-bottom));
}

.preview-hero {
  display: flex;
  gap: 24rpx;
  align-items: flex-end;
  justify-content: space-between;
  padding: 32rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.92);
  border-radius: var(--radius-xxl);
  background:
    linear-gradient(135deg, rgba(255, 253, 249, 0.88), rgba(255, 253, 249, 0) 58%),
    linear-gradient(160deg, #FFFDF9 0%, #F3E7D6 100%);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.hero-copy {
  min-width: 0;
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-tag-bg);
  color: var(--color-tag-text);
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 16rpx;
  color: var(--color-text-main);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.12;
}

.hero-desc {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-action {
  flex: 0 0 220rpx;
  width: 220rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.summary-card {
  min-height: 132rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.86);
  border-radius: var(--radius-lg);
  background: rgba(255, 253, 249, 0.86);
  box-shadow: var(--shadow-soft);
  box-sizing: border-box;
}

.summary-label {
  color: var(--color-text-muted);
  font-size: 22rpx;
  line-height: 1.35;
}

.summary-value {
  margin-top: 10rpx;
  color: var(--color-text-main);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
}

.progress,
.render-notice {
  margin-bottom: 18rpx;
}

.empty-panel {
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.empty-title {
  color: var(--color-text-main);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.empty-desc {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
}

.empty-action {
  margin-top: 28rpx;
}

.queue-title {
  display: flex;
  gap: 18rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.queue-title .muted {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.import-row {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.import-row::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--color-primary-light), var(--color-primary-deep));
}

.row-head {
  display: flex;
  gap: 18rpx;
  align-items: center;
  justify-content: space-between;
}

.check {
  gap: 12rpx;
  color: var(--color-text-main);
  font-size: 28rpx;
  font-weight: 800;
}

.match-tag {
  flex: 0 0 auto;
}

.raw-panel {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: var(--radius-md);
  background: var(--color-search-bg);
  border: 1rpx solid var(--color-border-light);
}

.raw-line {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  min-width: 0;
}

.raw-label {
  flex: 0 0 116rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.45;
}

.raw-text {
  flex: 1;
  min-width: 0;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.field-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.field-grid .input {
  width: 100%;
}

.picker {
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-search-bg);
  color: var(--color-text-main);
  box-sizing: border-box;
}

.action-picker {
  margin-top: 18rpx;
  font-weight: 800;
}

.match-panel {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-md);
  background: var(--color-success-bg);
  color: var(--color-success-text);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.candidates {
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-search-bg);
}

.candidate-title {
  margin-bottom: 8rpx;
  color: var(--color-text-main);
  font-size: 24rpx;
  font-weight: 800;
}

.candidate-line {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.row-warning,
.row-error {
  margin-top: 16rpx;
}

.sticky {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 32rpx;
  bottom: calc(32rpx + constant(safe-area-inset-bottom));
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 20;
  box-shadow: var(--shadow-float);
}

.import-preview-page.admin-responsive-page.is-landscape {
  display: grid;
  grid-template-columns: 380rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: start;
}

.import-preview-page.is-landscape .preview-hero,
.import-preview-page.is-landscape .summary-grid,
.import-preview-page.is-landscape .progress,
.import-preview-page.is-landscape .render-notice,
.import-preview-page.is-landscape .sticky {
  grid-column: 1;
}

.import-preview-page.is-landscape .queue-title,
.import-preview-page.is-landscape .empty-panel,
.import-preview-page.is-landscape .import-row {
  grid-column: 2;
}

.import-preview-page.is-landscape .preview-hero {
  position: sticky;
  top: 24rpx;
  z-index: 4;
  flex-direction: column;
  align-items: stretch;
}

.import-preview-page.is-landscape .hero-action {
  width: 100%;
  flex-basis: auto;
}

.import-preview-page.is-landscape .summary-grid {
  position: sticky;
  top: 330rpx;
  z-index: 4;
  grid-template-columns: 1fr;
}

.import-preview-page.is-landscape .field-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.import-preview-page.is-landscape .raw-panel {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.import-preview-page.is-landscape .sticky {
  position: sticky;
  bottom: 24rpx;
  left: auto;
  right: auto;
  width: 100%;
}

@media (min-width: 1024px) {
  .import-preview-page .field-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .import-preview-page .raw-panel {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
