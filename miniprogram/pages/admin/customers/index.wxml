<view class="page customers-page page-enter">
  <view class="customers-hero section">
    <view>
      <view class="hero-kicker">客户工作台</view>
      <view class="hero-title">客户管理</view>
      <view class="hero-desc">查看客户基础信息、风险状态、备注摘要和账款概览。</view>
    </view>
    <button class="btn btn-secondary hero-action" bindtap="searchNow">刷新</button>
  </view>

  <view class="card section search-card">
    <view class="search-head">
      <view>
        <view class="section-title">客户检索</view>
        <view class="card-desc">支持昵称、手机号、openid、标签和备注摘要。</view>
      </view>
    </view>
    <view class="field">
      <input class="input" placeholder="昵称 / 手机号 / openid / 标签 / 备注" value="{{keyword}}" bindinput="onKeyword"></input>
    </view>
    <button class="btn btn-primary search-btn" bindtap="searchNow">搜索客户</button>
  </view>

  <ui-skeleton wx:if="{{loading && !accounts.length}}" count="{{4}}" showThumb="{{false}}"></ui-skeleton>

  <view wx:if="{{!loading && !accounts.length}}" class="empty empty-panel">暂无客户记录</view>

  <view wx:for="{{accounts}}" wx:key="_id" class="card customer tap-card" bindtap="openDetail" data-id="{{item.userId}}">
    <view class="customer-accent risk-{{item.riskLevel}}"></view>
    <view class="row between customer-head">
      <view class="customer-main">
        <view class="customer-name">{{item.nickname || item.userOpenid || item.userId}}</view>
        <view class="openid">{{item.userOpenid || item.userId}}</view>
      </view>
      <view class="risk risk-{{item.riskLevel}}">{{item.riskText}}</view>
    </view>

    <view class="metric-grid">
      <view wx:if="{{item.phoneDisplay || item.phoneMasked}}" class="metric-cell">
        <view class="metric-label">手机号</view>
        <view class="metric-value">{{item.phoneDisplay || item.phoneMasked}}</view>
      </view>
      <view class="metric-cell">
        <view class="metric-label">今日订单</view>
        <view class="metric-value">￥{{item.todayText}}</view>
      </view>
      <view class="metric-cell">
        <view class="metric-label">历史未付</view>
        <view class="metric-value">￥{{item.historyUnpaidText}}</view>
      </view>
      <view class="metric-cell highlight">
        <view class="metric-label">当前未付</view>
        <view class="metric-value price">￥{{item.unpaidText}}</view>
      </view>
    </view>

    <view wx:if="{{item.tagsText}}" class="tags">{{item.tagsText}}</view>
    <view wx:if="{{item.hasAdminNote}}" class="note">备注摘要：{{item.adminNoteSummary}}</view>
  </view>

  <view wx:if="{{loadingMore}}" class="bottom-loading">继续加载</view>
  <view wx:if="{{!loadingMore && accounts.length && !hasMore}}" class="empty small-empty">已加载全部客户</view>
</view>
