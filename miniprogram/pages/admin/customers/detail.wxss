.customer-detail-page {
  background: #F8F4ED;
}

.detail-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 10rpx;
  margin-bottom: 18rpx;
}

.detail-hero-copy {
  min-width: 0;
}

.hero-kicker {
  color: #8A6A43;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-title {
  margin-top: 8rpx;
  color: #1F1A15;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.12;
  word-break: break-all;
}

.hero-desc {
  margin-top: 10rpx;
  color: #82776B;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
}

.hero-action {
  flex: 0 0 auto;
  min-width: 118rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.detail-grid {
  display: grid;
  gap: 18rpx;
}

.info-card,
.note-card,
.timeline-card {
  padding: 24rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.92);
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
  box-shadow: 0 10rpx 24rpx rgba(86, 62, 34, 0.07);
}

.section-title {
  color: #1F1A15;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.card-head {
  margin-bottom: 18rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EFE6DA;
}

.card-desc {
  margin-top: 6rpx;
  color: #82776B;
  font-size: 23rpx;
  line-height: 1.5;
}

.kv {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EFE6DA;
  color: #82776B;
  font-size: 24rpx;
}

.kv text:last-child {
  max-width: 420rpx;
  color: #1F1A15;
  font-weight: 700;
  text-align: right;
  word-break: break-all;
}

.account-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.account-cell {
  min-width: 0;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #F8F1E8;
  border: 1rpx solid #EFE6DA;
}

.account-cell.main {
  grid-column: 1 / -1;
  background: #FFF7EA;
}

.metric-label {
  color: #A79B8B;
  font-size: 21rpx;
  line-height: 1.35;
}

.metric-value {
  margin-top: 6rpx;
  color: #1F1A15;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.price {
  color: #9A2D2D;
  font-weight: 900;
}

.label {
  margin: 18rpx 0 8rpx;
  color: #82776B;
  font-size: 24rpx;
  font-weight: 700;
}

.textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #E6D8C7;
  border-radius: 20rpx;
  box-sizing: border-box;
  background: #FFFCF7;
  font-size: 26rpx;
  line-height: 1.55;
}

.input {
  width: 100%;
  box-sizing: border-box;
}

.picker-value {
  display: flex;
  align-items: center;
}

.tag-list,
.preset-list,
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.tag-pill,
.preset {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.tag-pill {
  background: #F3E7D6;
  color: #8A6A43;
}

.preset {
  background: #EFE6DA;
  color: #82776B;
}

.action-btn {
  flex: 1 1 220rpx;
  min-width: 220rpx;
  border-radius: 999rpx;
}

.empty-line {
  padding: 22rpx 0 6rpx;
  color: #82776B;
  font-size: 24rpx;
}

.order-row,
.log-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EFE6DA;
}

.order-row:last-child,
.log-row:last-child {
  border-bottom: 0;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.between {
  justify-content: space-between;
}

.row-title {
  flex: 1;
  min-width: 0;
  color: #1F1A15;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.4;
  word-break: break-all;
}

.row-time,
.row-meta {
  color: #82776B;
  font-size: 22rpx;
  line-height: 1.45;
}

.row-time {
  flex: 0 0 auto;
  max-width: 260rpx;
  text-align: right;
}

.row-meta {
  margin-top: 6rpx;
  word-break: break-all;
}

@media (min-width: 700px) {
  .detail-grid {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  }

  .account-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
