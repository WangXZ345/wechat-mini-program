.unsold-page {
  background: #F8F4ED;
}

.unsold-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding-top: 10rpx;
  margin-bottom: 18rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-kicker,
.section-kicker {
  color: #8A6A43;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-title {
  margin-top: 8rpx;
  color: #1F1A15;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.08;
}

.hero-desc {
  margin-top: 10rpx;
  color: #82776B;
  font-size: 24rpx;
  line-height: 1.5;
}

.export-btn {
  flex: 0 0 188rpx;
  width: 188rpx;
  height: 66rpx;
  line-height: 66rpx;
  margin: 4rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.summary-card,
.range-card,
.filter-card,
.unsold-product {
  border-radius: 28rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.92);
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
  box-shadow: 0 10rpx 24rpx rgba(86, 62, 34, 0.07);
}

.summary-card {
  min-height: 124rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.active-summary {
  background: linear-gradient(180deg, #FFFDF9 0%, #FFF7EA 100%);
}

.summary-num {
  color: #8A6A43;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
}

.summary-label {
  margin-top: 8rpx;
  color: #82776B;
  font-size: 23rpx;
}

.range-card,
.filter-card {
  padding: 24rpx;
}

.card-head {
  margin-bottom: 18rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EFE6DA;
}

.section-title {
  color: #1F1A15;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.card-desc {
  margin-top: 6rpx;
  color: #82776B;
  font-size: 23rpx;
  line-height: 1.5;
}

.range-scroll {
  margin: 0 -24rpx;
  white-space: nowrap;
}

.range-tabs {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx 4rpx;
}

.tab {
  flex: 0 0 auto;
  min-width: 152rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E6D8C7;
  background: #FFFDF9;
  color: #82776B;
  font-size: 23rpx;
  font-weight: 700;
}

.active-tab {
  border-color: #9A856B;
  background: #9A856B;
  color: #FFFFFF;
  box-shadow: 0 8rpx 18rpx rgba(120, 95, 62, 0.16);
}

.custom-row,
.filter-grid,
.filter-footer,
.edit-line {
  display: grid;
  gap: 14rpx;
}

.custom-row {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 18rpx;
}

.query-btn {
  grid-column: 1 / span 2;
  height: 66rpx;
  line-height: 66rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.input {
  box-sizing: border-box;
}

.filter-input {
  width: 100%;
}

.filter-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 14rpx;
}

.filter-field {
  min-width: 0;
  width: 100%;
  margin-top: 0;
}

.picker-box {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #E6D8C7;
  border-radius: 18rpx;
  background: #FFFDF9;
  color: #82776B;
  box-sizing: border-box;
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-footer {
  grid-template-columns: minmax(0, 1fr) 156rpx;
  align-items: stretch;
  margin-top: 14rpx;
}

.sort-picker {
  min-width: 0;
}

.sort-box {
  width: 100%;
}

.clear-btn {
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.list-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.list-title {
  margin-top: 4rpx;
  color: #1F1A15;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.18;
}

.list-range {
  flex: 0 1 auto;
  max-width: 360rpx;
  min-height: 42rpx;
  line-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #F3E7D6;
  color: #8A6A43;
  font-size: 21rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loading-panel,
.small-empty {
  padding: 28rpx 24rpx;
  color: #82776B;
  font-size: 24rpx;
  text-align: center;
}

.unsold-product {
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.product-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.thumb {
  flex: 0 0 136rpx;
  width: 136rpx;
  height: 136rpx;
  border-radius: 22rpx;
  background: #EFE6DA;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #BBAA96;
  font-size: 24rpx;
}

.info {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.name {
  flex: 1;
  min-width: 0;
  color: #1F1A15;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.tag {
  flex: 0 0 auto;
  max-width: 128rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #E9F0E1;
  color: #566F49;
  font-size: 21rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag.inactive {
  background: #F6E5DE;
  color: #9A2D2D;
}

.small-text {
  margin-top: 7rpx;
  color: #A79B8B;
  font-size: 22rpx;
  line-height: 1.35;
  word-break: break-all;
}

.marker-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  min-height: 32rpx;
  margin-top: 10rpx;
}

.marker {
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #F3E7D6;
  color: #8A6A43;
  font-size: 20rpx;
  font-weight: 800;
}

.marker.clearance {
  background: #F6E5DE;
  color: #9A2D2D;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.meta-cell {
  min-width: 0;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #F8F1E8;
  border: 1rpx solid #EFE6DA;
}

.meta-label {
  color: #A79B8B;
  font-size: 20rpx;
}

.meta-value {
  margin-top: 6rpx;
  color: #1F1A15;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminders {
  margin-top: 14rpx;
}

.reminder {
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  background: #FFF7EA;
  color: #8A6A43;
  font-size: 23rpx;
  line-height: 1.45;
}

.edit-panel {
  display: grid;
  gap: 12rpx;
  margin-top: 16rpx;
}

.edit-line {
  grid-template-columns: minmax(0, 1fr) 132rpx;
}

.edit-input {
  width: 100%;
  height: 68rpx;
  min-height: 68rpx;
  margin-top: 0;
  font-size: 23rpx;
}

.edit-btn {
  height: 68rpx;
  line-height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  min-width: 0;
  height: 62rpx;
  line-height: 62rpx;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

@media (min-width: 700px) {
  .summary-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .filter-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .meta-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .actions {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
