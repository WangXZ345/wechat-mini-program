.orders-page.has-batch-bar {
  padding-bottom: 220rpx;
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.orders-header {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 32rpx 24rpx;
  margin: -24rpx -24rpx 24rpx;
  border-radius: 0 0 36rpx 36rpx;
  background:
    radial-gradient(circle at 88% 0, rgba(255, 253, 249, 0.34), rgba(255, 253, 249, 0) 260rpx),
    linear-gradient(135deg, #C7AE8B, #9A856B);
  box-shadow: 0 12rpx 30rpx rgba(142, 116, 86, 0.14);
}

.orders-header-copy {
  min-width: 0;
}

.eyebrow {
  margin-bottom: 8rpx;
  color: rgba(31, 26, 21, 0.58);
  font-size: 22rpx;
  font-weight: 800;
}

.orders-subtitle {
  margin-top: 8rpx;
  color: rgba(31, 26, 21, 0.68);
  font-size: 26rpx;
  line-height: 1.45;
}

.orders-title {
  color: #1F1A15;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: 0;
  white-space: normal;
  word-break: keep-all;
}

.orders-hero-panel {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  overflow-x: auto;
}

.hero-metric {
  flex: 1;
  min-width: 150rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 253, 249, 0.52);
  border-radius: 24rpx;
  background: rgba(255, 253, 249, 0.54);
  box-sizing: border-box;
}

.hero-value {
  color: #1F1A15;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.1;
}

.hero-label {
  margin-top: 6rpx;
  color: rgba(31, 26, 21, 0.66);
  font-size: 22rpx;
  font-weight: 700;
}

.hero-filter-pill {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  max-width: 360rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.72);
  color: #5D4528;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 76rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.header-actions,
.order-title-row {
  gap: 12rpx;
}

.header-actions {
  margin-top: 14rpx;
}

.order-title-row {
  align-items: center;
  min-width: 0;
}

.select-dot {
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #C7AE8B;
  border-radius: 50%;
  background: #FFFDF9;
  box-sizing: border-box;
  flex-shrink: 0;
}

.select-dot.selected {
  border: 10rpx solid #A8793A;
  background: #FFF7EA;
}

.filter-card {
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
  border-color: rgba(230, 216, 199, 0.82);
}

.filter-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 4rpx;
}

.section-kicker {
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.filter-summary-pill {
  flex-shrink: 0;
  max-width: 320rpx;
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--color-tag-bg);
  color: var(--color-tag-text);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 50rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.field {
  flex: 1;
  min-width: 300rpx;
  margin-top: 16rpx;
}

.label {
  margin-bottom: 8rpx;
  color: #82776B;
  font-size: 24rpx;
  font-weight: 600;
}

.picker-value {
  line-height: 76rpx;
}

.switch-row {
  margin-top: 18rpx;
}

.export-actions {
  gap: 12rpx;
}

.orders-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 92rpx;
  margin: 8rpx 0 28rpx;
}

.pagination-button {
  min-width: 260rpx;
}

.pagination-end {
  font-size: 24rpx;
}

.export-result {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E6D8C7;
}

.file-name {
  margin-top: 8rpx;
  word-break: break-all;
}

.shipment-line {
  gap: 12rpx;
  margin-top: 10rpx;
  justify-content: flex-start;
}

.shipment-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EFE6DA;
  color: #82776B;
  font-size: 24rpx;
  font-weight: 700;
}

.shipment-badge.merged {
  background: #F3E7D6;
  color: #8A6A43;
}

.actions {
  gap: 12rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.admin-order-card .actions .small {
  min-width: 160rpx;
}

.small {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
}

.mini {
  flex: 1;
  width: auto;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  margin: 0;
  padding: 0;
}

.orders-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 28rpx 2rpx 18rpx;
}

.section-title {
  margin-top: 4rpx;
  color: var(--color-text-main);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.18;
}

.orders-section-note {
  flex-shrink: 0;
  max-width: 300rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
}

.order {
  margin-bottom: 20rpx;
}

.admin-order-card {
  position: relative;
  overflow: hidden;
  padding-top: 28rpx;
  border-radius: 32rpx;
  border-color: rgba(230, 216, 199, 0.82);
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
}

.order-card-accent {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 8rpx;
  background: linear-gradient(90deg, #C7AE8B, rgba(199, 174, 139, 0.18));
}

.screenshot {
  width: 180rpx;
  height: 180rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #E6D8C7;
}

.screenshot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 2rpx;
}

.status-row {
  gap: 8rpx;
  justify-content: flex-start;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.order-card-header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.paid-order {
  border-color: #D9E5CB;
  background: linear-gradient(180deg, #FFFDF9 0%, #FBFCF7 100%);
}

.paid-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #6F8A5F;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.note-badge,
.risk-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.note-badge {
  background: #F3E7D6;
  color: #8A6A43;
}

.risk-badge {
  background: #F3E7D6;
  color: #8A6A43;
}

.risk-slow_pay {
  background: #FFF7EA;
  color: #8A6A43;
}

.risk-risk,
.risk-blocked {
  background: #F6E5DE;
  color: #9A2D2D;
}

.risk-important {
  background: #E9F0E1;
  color: #566F49;
}

.note-summary {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: #FFF7EA;
  color: #8A6A43;
  font-size: 24rpx;
}

.order-title-row .subtitle {
  min-width: 0;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.order-info-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.info-panel {
  min-width: 0;
  padding: 16rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.72);
  border-radius: 22rpx;
  background: rgba(255, 253, 249, 0.68);
}

.info-label {
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.info-main {
  margin-top: 6rpx;
  color: var(--color-text-main);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
  word-break: break-all;
}

.info-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.order-payment-panel {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 234, 0.82);
  border: 1rpx solid rgba(230, 216, 199, 0.72);
}

.payment-main {
  margin-top: 6rpx;
  color: #5D4528;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.payment-total {
  flex-shrink: 0;
  min-width: 180rpx;
  text-align: right;
}

.payment-total .price {
  font-size: 34rpx;
  line-height: 1.2;
}

.items-title {
  padding: 16rpx 0 0;
  color: var(--color-text-main);
  font-size: 26rpx;
  font-weight: 900;
}

.admin-note {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EFE6DA;
}

.order,
.filter-card {
  box-shadow: var(--shadow-card);
}

.order:active {
  opacity: 0.96;
}

.small-title {
  font-size: 26rpx;
}

.tiny {
  width: 112rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  margin: 0;
}

.note-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #E6D8C7;
  border-radius: 20rpx;
  box-sizing: border-box;
  background: #FFFDF9;
  font-size: 26rpx;
}

.note-logs {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: #FFFCF7;
}

.log-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #E6D8C7;
  font-size: 24rpx;
}

.log-row:last-child {
  border-bottom: 0;
}

.log-name {
  font-weight: 700;
  color: #1F1A15;
}

.items {
  margin-top: 16rpx;
  border-top: 1rpx solid #EFE6DA;
}

.item-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EFE6DA;
}

.item-name {
  max-width: 460rpx;
  font-weight: 600;
  color: #1F1A15;
}

.address-summary {
  margin-top: 14rpx;
  line-height: 1.6;
  word-break: break-all;
}

.batch-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  bottom: calc(24rpx + constant(safe-area-inset-bottom));
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(199, 174, 139, 0.72);
  border-radius: 28rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFDF9 100%);
  box-shadow:
    0 24rpx 64rpx rgba(64, 48, 30, 0.24),
    0 8rpx 20rpx rgba(142, 116, 86, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
  overflow: hidden;
}

.batch-info {
  min-width: 0;
}

.batch-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F1A15;
  line-height: 1.3;
  white-space: nowrap;
}

.batch-sub {
  margin-top: 6rpx;
  color: #82776B;
  font-size: 22rpx;
  line-height: 1.4;
  word-break: break-all;
}

.batch-actions {
  display: flex;
  width: 100%;
  gap: 14rpx;
}

.batch-btn {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  padding: 0;
  white-space: nowrap;
}

.orders-page.is-landscape .orders-header {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
}

.orders-page.is-landscape .orders-header-copy {
  flex: 1 1 320rpx;
}

.orders-page.is-landscape .orders-hero-panel {
  flex: 1 1 420rpx;
}

.orders-page.is-landscape .header-actions {
  margin-top: 0;
  flex: 0 0 240rpx;
}

.orders-page.is-landscape .filter-card {
  position: sticky;
  top: 0;
  z-index: 8;
}

.orders-page.is-landscape .filter-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.orders-page.is-landscape .field {
  min-width: 0;
}

.orders-page.is-landscape .order.admin-order-card {
  display: block;
}

.orders-page.is-landscape .order-card-header {
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.orders-page.is-landscape .order-title-row {
  flex: 1;
}

.orders-page.is-landscape .order-info-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.orders-page.is-landscape .order-payment-panel {
  align-items: center;
}

.orders-page.is-landscape .items {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 24rpx;
}

.orders-page.is-landscape .items-title {
  grid-column: 1 / -1;
}

.orders-page.is-landscape .item-row {
  min-width: 0;
}

.orders-page.is-landscape .status-row {
  margin-top: 0;
  justify-content: flex-end;
}

.orders-page.is-landscape .screenshot {
  width: 140rpx;
  height: 140rpx;
}

.orders-page.is-landscape .batch-bar {
  left: calc(48rpx + constant(safe-area-inset-left));
  left: calc(48rpx + env(safe-area-inset-left));
  right: calc(48rpx + constant(safe-area-inset-right));
  right: calc(48rpx + env(safe-area-inset-right));
  flex-direction: row;
  align-items: center;
}

.orders-page.is-landscape .batch-actions {
  width: auto;
  flex: 0 0 360rpx;
}
