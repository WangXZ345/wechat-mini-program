<view class="page page-enter admin-responsive-page refund-detail-page {{isLandscape ? 'is-landscape' : 'is-portrait'}} {{isWideScreen ? 'is-wide' : ''}}">
  <ui-skeleton wx:if="{{loading}}" count="{{3}}" showThumb="{{false}}"></ui-skeleton>
  <ui-empty wx:if="{{!loading && !refund}}" icon="!" title="退款记录不存在" description="请返回退款列表重新打开"></ui-empty>

  <block wx:if="{{!loading && refund}}">
    <view class="detail-hero section">
      <view class="hero-copy">
        <view class="hero-kicker">退款详情</view>
        <view class="hero-title">{{refund.refundNo}}</view>
        <view class="hero-desc">售后单号：{{refund.afterSaleNo}}｜订单号：{{refund.orderNo}}</view>
      </view>
      <view class="tag hero-status">{{refund.refundText}}</view>
      <view class="hero-metrics">
        <view class="hero-metric">
          <view class="metric-label">客户</view>
          <view class="metric-value">{{refund.customerName || "未填写"}}</view>
        </view>
        <view class="hero-metric">
          <view class="metric-label">退款方式</view>
          <view class="metric-value">{{refund.refundMethod}}</view>
        </view>
        <view class="hero-metric">
          <view class="metric-label">退款金额</view>
          <view class="metric-value price">￥{{refund.amountText}}</view>
        </view>
      </view>
    </view>

    <view class="detail-layout">
      <view class="main-column">
        <view class="card section info-card">
          <view class="subtitle">退款基础信息</view>
          <view class="kv"><text>原支付方式</text><text>{{refund.originalPaymentMethodType || "未记录"}}</text></view>
          <view class="kv"><text>创建时间</text><text>{{refund.createdAtText}}</text></view>
          <view class="kv"><text>确认时间</text><text>{{refund.confirmedAtText || "未确认"}}</text></view>
        </view>

        <view class="card section info-card">
          <view class="subtitle">售后审核前置</view>
          <view class="kv"><text>售后状态</text><text>{{afterSale.statusText}}</text></view>
          <view class="kv"><text>审批退款</text><text>￥{{afterSale.approvedRefundText}}</text></view>
          <view class="kv"><text>已退金额</text><text>￥{{afterSale.actualRefundText}}</text></view>
          <view class="kv"><text>审核时间</text><text>{{afterSale.reviewedAtText || "未审核"}}</text></view>
          <view class="notice notice-danger warning-text" wx:if="{{afterSale.afterSaleStatus === 'pending_review'}}">售后未审核通过，不能退款。</view>
        </view>

        <view class="card section info-card">
          <view class="subtitle">退款凭证</view>
          <view wx:if="{{!refund.refundProofImages.length}}" class="muted empty-line">暂无凭证</view>
          <view class="image-grid" wx:if="{{refund.refundProofImages.length}}">
            <image wx:for="{{refund.refundProofImages}}" wx:key="*this" src="{{item}}" mode="aspectFit" lazy-load="true"></image>
          </view>
          <view wx:if="{{refund.financeRemark}}" class="muted finance-remark">财务备注：{{refund.financeRemark}}</view>
          <view wx:if="{{refund.failedReason}}" class="notice notice-warning warning-text">失败/拒绝原因：{{refund.failedReason}}</view>
        </view>

        <view class="card section info-card">
          <view class="subtitle">操作日志</view>
          <view wx:for="{{logs}}" wx:key="_id" class="log-row">
            <view>{{item.remark || item.action}}</view>
            <view class="muted">{{item.createdAtText}}</view>
          </view>
        </view>
      </view>

      <view class="side-column">
        <view class="card section action-card" wx:if="{{refund.refundStatus !== 'refunded'}}">
          <view class="subtitle">财务处理</view>
          <view class="muted action-hint">确认线下退款会写入退款记录、订单退款字段和客户账款流水。</view>
          <input class="input" type="digit" value="{{refundAmountYuan}}" data-field="refundAmountYuan" bindinput="onInput" placeholder="退款金额，单位元" />
          <textarea class="textarea" value="{{financeRemark}}" data-field="financeRemark" bindinput="onInput" placeholder="财务备注"></textarea>
          <view class="row between proof-title">
            <view class="muted">退款凭证</view>
            <button class="mini-btn" bindtap="chooseProofImages">上传</button>
          </view>
          <view class="image-grid local-proof-grid">
            <view wx:for="{{proofImages}}" wx:key="*this" class="image-box">
              <image src="{{item}}" mode="aspectFill"></image>
              <view class="remove" catchtap="removeProof" data-index="{{index}}">×</view>
            </view>
          </view>
          <button class="btn btn-primary action-full" loading="{{processing}}" disabled="{{processing}}" bindtap="processRefund">确认线下退款</button>
          <button class="btn btn-secondary action-full" loading="{{processing}}" disabled="{{processing}}" bindtap="wechatRefund">发起微信退款</button>
          <textarea class="textarea" value="{{failedReason}}" data-field="failedReason" bindinput="onInput" placeholder="退款拒绝或失败原因"></textarea>
          <button class="btn btn-secondary action-full danger-action" bindtap="rejectRefund">标记退款拒绝</button>
        </view>
      </view>
    </view>
  </block>
</view>
