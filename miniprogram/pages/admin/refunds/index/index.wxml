<view class="page page-enter admin-responsive-page refunds-page {{isLandscape ? 'is-landscape' : 'is-portrait'}} {{isWideScreen ? 'is-wide' : ''}}">
  <view class="refund-hero section">
    <view class="hero-copy">
      <view class="hero-kicker">财务退款</view>
      <view class="hero-title">退款记录</view>
      <view class="hero-desc">财务只处理已审核通过的售后退款，线下退款和微信退款都需要进入详情确认。</view>
    </view>
  </view>

  <view class="card filter-panel section">
    <view class="filter-summary">
      <view>
        <view class="subtitle">退款筛选</view>
        <view class="muted">当前：{{statusOptions[statusIndex].label}}</view>
      </view>
      <view class="tag">共 {{refunds.length || 0}} 笔</view>
    </view>
    <view class="filter-grid">
      <picker class="filter-picker" mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange">
        <view>{{statusOptions[statusIndex].label}}</view>
      </picker>
      <view class="search-row">
        <input class="search-input" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="load" placeholder="退款单号/售后单号/订单号/客户" />
        <button class="mini-btn search-btn" bindtap="load">搜索</button>
      </view>
    </view>
    <view class="row export-row">
      <button class="mini-btn export-btn" loading="{{exporting}}" disabled="{{exporting}}" bindtap="exportExcel">导出 Excel</button>
      <button wx:if="{{exportResult.fileUrl}}" class="mini-btn export-btn" bindtap="copyExportLink">复制链接</button>
    </view>
  </view>

  <ui-skeleton wx:if="{{loading}}" count="{{4}}" showThumb="{{false}}"></ui-skeleton>
  <ui-empty wx:if="{{!loading && !refunds.length}}" icon="退" title="暂无退款记录" description="审核通过售后后可创建退款记录"></ui-empty>

  <view wx:if="{{refunds.length}}" class="queue-title section">
    <view>
      <view class="subtitle">退款队列</view>
      <view class="muted">点击卡片进入详情执行退款确认、微信退款或拒绝处理。</view>
    </view>
  </view>

  <view wx:for="{{refunds}}" wx:key="_id" class="card section refund-card card-press" bindtap="goDetail" data-id="{{item._id}}">
    <view class="card-line"></view>
    <view class="refund-head">
      <view>
        <view class="subtitle refund-no">{{item.refundNo}}</view>
        <view class="muted order-no">售后单号：{{item.afterSaleNo}}</view>
      </view>
      <view class="tag">{{item.refundText}}</view>
    </view>
    <view class="order-chip">订单号：{{item.orderNo}}</view>
    <view class="metric-grid">
      <view class="metric-box">
        <view class="metric-label">客户</view>
        <view class="metric-value">{{item.customerName || "未填写"}}</view>
      </view>
      <view class="metric-box">
        <view class="metric-label">退款方式</view>
        <view class="metric-value">{{item.refundMethod}}</view>
      </view>
      <view class="metric-box amount-box">
        <view class="metric-label">退款金额</view>
        <view class="metric-value price">￥{{item.amountText}}</view>
      </view>
    </view>
    <view class="muted created">创建时间：{{item.createdAtText}}</view>
  </view>
</view>
