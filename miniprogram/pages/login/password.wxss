.password-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 44rpx 28rpx 56rpx;
  background: var(--color-bg);
  color: var(--color-text-main);
}

.password-hero {
  padding: 10rpx 4rpx 28rpx;
}

.eyebrow {
  margin-bottom: 8rpx;
  color: var(--color-primary-deep);
  font-size: 22rpx;
  font-weight: 800;
}

.page-title {
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.08;
}

.page-desc {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
}

.security-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.9);
  border-radius: 28rpx;
  background: linear-gradient(180deg, var(--color-card) 0%, var(--color-card-warm) 100%);
  padding: 26rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  padding-left: 4rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  font-weight: 700;
}

.password-input {
  width: 100%;
  height: 82rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-search-bg);
  color: var(--color-text-main);
  font-size: 27rpx;
}

.primary-button {
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  margin: 4rpx 0 0;
  border: 0;
  border-radius: var(--radius-pill);
  background: linear-gradient(180deg, #C7AE8B 0%, #B99C74 52%, #9A856B 100%);
  color: #FFFDF9;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: var(--shadow-button), var(--shadow-inset);
}

.primary-button::after {
  border: 0;
}

.password-page.is-landscape {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: 32rpx;
  align-items: center;
  padding-top: 28rpx;
}

.password-page.is-landscape .password-hero {
  padding-left: 12rpx;
}

.password-page.is-landscape .security-card {
  max-width: 680rpx;
}

.password-page.is-wide {
  max-width: 1180rpx;
  margin: 0 auto;
}
