<view class="password-page motion-page-enter {{isLandscape ? 'is-landscape' : 'is-portrait'}} {{isWideScreen ? 'is-wide' : ''}}">
  <view class="password-hero">
    <view class="eyebrow">账号安全</view>
    <view class="page-title">{{mode === 'change' ? '修改密码' : '设置密码'}}</view>
    <view class="page-desc">{{mode === 'change' ? '确认原密码后保存新的登录密码。' : '首次设置后，可使用手机号 + 密码登录。'}}</view>
  </view>

  <view class="security-card">
    <view class="field-group" wx:if="{{mode === 'change'}}">
      <view class="field-label">原密码</view>
      <input
        class="password-input"
        password="{{true}}"
        placeholder="请输入原密码"
        value="{{oldPassword}}"
        bindinput="onOldPasswordInput"
      ></input>
    </view>

    <view class="field-group">
      <view class="field-label">新密码</view>
      <input
        class="password-input"
        password="{{true}}"
        maxlength="32"
        placeholder="至少 6 位"
        value="{{password}}"
        bindinput="onPasswordInput"
      ></input>
    </view>

    <view class="field-group">
      <view class="field-label">确认新密码</view>
      <input
        class="password-input"
        password="{{true}}"
        maxlength="32"
        placeholder="再次输入新密码"
        value="{{confirmPassword}}"
        bindinput="onConfirmPasswordInput"
        confirm-type="done"
        bindconfirm="submit"
      ></input>
    </view>

    <button class="primary-button pressable" bindtap="submit" loading="{{loading}}" disabled="{{loading}}">{{mode === 'change' ? '保存新密码' : '设置密码'}}</button>
  </view>
</view>
