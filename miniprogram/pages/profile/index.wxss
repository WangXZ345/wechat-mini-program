.profile-page {
  --color-text-secondary: #74695E;
  --color-text-muted: #786E64;
  padding: 28rpx 30rpx;
  padding-bottom: 188rpx;
  padding-bottom: calc(188rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(188rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 12rpx 2rpx 28rpx;
}

.profile-title {
  color: var(--color-text-main);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.12;
  letter-spacing: 0;
}

.entry-tile::after,
.link-row::after,
.logout-action::after {
  border: 0;
}

.profile-layout {
  display: block;
}

.profile-card,
.section-panel,
.logout-action {
  width: 100%;
  margin: 0 0 22rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.82);
  border-radius: var(--radius-lg);
  background: var(--color-card);
  box-shadow: 0 10rpx 28rpx rgba(120, 95, 62, 0.07);
  box-sizing: border-box;
}

.identity-card {
  padding: 26rpx 28rpx;
}

.identity-link {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 116rpx;
}

.avatar-shell {
  position: relative;
  flex: 0 0 auto;
  width: 108rpx;
  height: 108rpx;
  overflow: hidden;
  border: 3rpx solid rgba(185, 156, 116, 0.38);
  border-radius: 50%;
  background: var(--color-card-warm);
  box-shadow: 0 8rpx 20rpx rgba(120, 95, 62, 0.08);
  box-sizing: border-box;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  position: relative;
  color: var(--color-primary);
}

.avatar-user-head {
  position: absolute;
  left: 36rpx;
  top: 22rpx;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.avatar-user-body {
  position: absolute;
  left: 25rpx;
  bottom: 20rpx;
  width: 52rpx;
  height: 32rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 999rpx 999rpx 0 0;
  box-sizing: border-box;
}

.identity-copy {
  min-width: 0;
  flex: 1;
}

.identity-name {
  color: var(--color-text-main);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
  word-break: break-all;
}

.identity-meta {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.35;
}

.chevron {
  flex: 0 0 auto;
  margin-left: auto;
  color: var(--color-text-muted);
  font-size: 38rpx;
  line-height: 1;
}

.nickname-editor {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.field-label {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
}

.nickname-input {
  margin: 12rpx 0 18rpx;
}

.editor-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.editor-btn {
  width: 176rpx;
  margin: 0;
}

.phone-card,
.admin-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.account-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.account-icon,
.row-icon {
  position: relative;
  flex: 0 0 auto;
  color: var(--color-primary-deep);
  box-sizing: border-box;
}

.account-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: var(--color-card-warm);
}

.phone-icon::before {
  content: "";
  position: absolute;
  left: 23rpx;
  top: 14rpx;
  width: 20rpx;
  height: 36rpx;
  border: 3rpx solid currentColor;
  border-radius: 7rpx;
  box-sizing: border-box;
}

.phone-icon::after {
  content: "";
  position: absolute;
  left: 30rpx;
  bottom: 19rpx;
  width: 6rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.admin-icon::before,
.admin-icon::after {
  content: "";
  position: absolute;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
}

.admin-icon::before {
  left: 23rpx;
  top: 13rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.admin-icon::after {
  left: 16rpx;
  bottom: 12rpx;
  width: 34rpx;
  height: 20rpx;
  border-bottom: 0;
  border-radius: 999rpx 999rpx 0 0;
}

.account-copy {
  min-width: 0;
  flex: 1;
}

.section-title {
  color: var(--color-text-main);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: 0;
}

.muted {
  margin-top: 6rpx;
  line-height: 1.45;
}

.status-badge,
.role-pill {
  flex: 0 0 auto;
  max-width: 220rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.82);
  border-radius: var(--radius-pill);
  background: var(--color-card-warm);
  color: var(--color-tag-text);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  box-sizing: border-box;
}

.account-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--color-border-light);
  border-bottom: 1rpx solid var(--color-border-light);
}

.account-meta-item {
  min-width: 0;
}

.meta-label {
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.meta-value {
  margin-top: 6rpx;
  color: var(--color-text-main);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}

.panel-heading {
  margin-bottom: 20rpx;
}

.entry-grid {
  display: flex;
  width: 100%;
  gap: 0;
}

.entry-tile {
  display: flex;
  flex: 0 0 33.333333%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 33.333333%;
  min-width: 0;
  min-height: 150rpx;
  margin: 0;
  padding: 14rpx 10rpx;
  border: 0;
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--color-text-main);
  text-align: center;
  box-sizing: border-box;
}

.entry-icon {
  position: relative;
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 14rpx;
  color: var(--color-text-main);
  box-sizing: border-box;
}

.order-icon {
  border: 3rpx solid currentColor;
  border-radius: 10rpx;
}

.order-icon::before,
.order-icon::after {
  content: "";
  position: absolute;
  left: 11rpx;
  right: 11rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.order-icon::before {
  top: 16rpx;
}

.order-icon::after {
  top: 29rpx;
}

.address-icon {
  border: 3rpx solid currentColor;
  border-radius: 50% 50% 50% 9rpx;
  transform: rotate(-45deg) scale(0.84);
}

.address-icon::after {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.service-icon {
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.service-icon::before {
  content: "";
  position: absolute;
  left: 11rpx;
  right: 11rpx;
  top: 23rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.entry-title {
  width: 100%;
  color: var(--color-text-main);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
}

.entry-desc {
  width: 100%;
  margin-top: 5rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
  line-height: 1.3;
}

.entry-list {
  margin-top: 0;
  width: 100%;
}

.link-row,
.logout-action {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  width: 100%;
  color: var(--color-text-main);
  font-size: 28rpx;
  font-weight: 600;
  text-align: left;
  box-sizing: border-box;
}

.link-row {
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid var(--color-border-light);
  border-radius: 0;
  background: transparent;
}

.link-row:last-child {
  border-bottom: 0;
}

.link-main {
  display: flex;
  align-items: center;
  flex: 0 1 auto;
  gap: 18rpx;
  min-width: 0;
  text-align: left;
}

.link-main text {
  min-width: 0;
  flex: 0 1 auto;
}

.row-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-card-warm);
}

.lock-icon::before {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 20rpx;
  width: 18rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.lock-icon::after {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 11rpx;
  width: 12rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 999rpx 999rpx 0 0;
  box-sizing: border-box;
}

.privacy-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 10rpx 10rpx 12rpx 12rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.privacy-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 5rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -28%);
}

.agreement-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.agreement-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 45%;
  width: 10rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 8rpx 0 currentColor;
  transform: translateX(-50%);
}

.payment-rule-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.payment-rule-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 47%;
  width: 18rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 7rpx 0 -1rpx currentColor;
  transform: translateX(-50%);
}

.after-sale-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 23rpx;
  height: 17rpx;
  border: 3rpx solid currentColor;
  border-right: 0;
  border-radius: 10rpx 0 0 10rpx;
  box-sizing: border-box;
  transform: translate(-45%, -50%);
}

.after-sale-icon::after {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 13rpx;
  width: 0;
  height: 0;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  border-right: 8rpx solid currentColor;
}

.defective-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 42%;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.defective-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 42%;
  width: 4rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 15rpx 0 currentColor;
  transform: translate(-50%, -50%);
}

.logout-action {
  min-height: 88rpx;
  color: var(--color-danger);
}

.logout-icon {
  color: var(--color-danger);
}

.logout-icon::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 11rpx;
  width: 18rpx;
  height: 26rpx;
  border: 3rpx solid currentColor;
  border-right: 0;
  border-radius: 5rpx 0 0 5rpx;
  box-sizing: border-box;
}

.logout-icon::after {
  content: "→";
  position: absolute;
  right: 7rpx;
  top: 6rpx;
  color: currentColor;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.profile-page.is-landscape .profile-layout {
  display: block;
}

.profile-page.is-landscape .profile-main,
.profile-page.is-landscape .profile-side {
  min-width: 0;
}

.profile-page.is-wide .profile-layout,
.profile-page.is-wide .profile-hero {
  max-width: 1400rpx;
  margin-left: auto;
  margin-right: auto;
}

.profile-page.is-wide .profile-layout {
  display: grid;
  grid-template-columns: 480rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: start;
}

.profile-page.is-wide.backend-only .profile-layout {
  max-width: 900rpx;
  grid-template-columns: 1fr;
}

@media (max-width: 360px) {
  .profile-page {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .profile-title {
    font-size: 52rpx;
  }

  .account-meta-grid {
    grid-template-columns: 1fr;
  }
}
