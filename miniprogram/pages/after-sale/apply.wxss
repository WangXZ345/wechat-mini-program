.after-sale-apply-page {
  padding-bottom: 88rpx;
}

.after-sale-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 18rpx 2rpx 16rpx;
  margin: 0 0 16rpx;
}

.after-sale-header-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  color: #8A6A43;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}

.after-sale-header .page-title {
  margin-top: 6rpx;
  color: #1F1A15;
  font-size: 62rpx;
  font-weight: 900;
  line-height: 1.06;
  letter-spacing: 0;
}

.after-sale-header .muted {
  margin-top: 8rpx;
  color: rgba(31, 26, 21, 0.60);
  font-size: 25rpx;
  line-height: 1.38;
}

.after-sale-state-pill {
  flex-shrink: 0;
  min-height: 50rpx;
  line-height: 50rpx;
  margin-top: 8rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.86);
  color: #8A6A43;
  font-size: 23rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(142, 116, 86, 0.06);
}

.after-sale-summary-card,
.after-sale-form-card {
  border-radius: 30rpx;
  border-color: rgba(230, 216, 199, 0.82);
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
  box-shadow: 0 10rpx 28rpx rgba(142, 116, 86, 0.08);
}

.section-kicker {
  margin-bottom: 14rpx;
  color: #8A6A43;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}

.summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.summary-order {
  flex: 1;
  min-width: 0;
}

.summary-amount {
  flex-shrink: 0;
  text-align: right;
}

.summary-amount .price {
  margin-top: 4rpx;
  font-size: 38rpx;
  line-height: 1.08;
}

.order-no {
  margin-top: 6rpx;
  word-break: break-all;
}

.summary-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 18rpx 0 2rpx;
  border-top: 1rpx solid #EFE6DA;
}

.summary-metric {
  min-width: 0;
  padding: 0 12rpx;
  text-align: center;
  border-left: 1rpx solid #EFE6DA;
}

.summary-metric:first-child {
  border-left: 0;
}

.summary-metric-label {
  display: block;
  color: #82776B;
  font-size: 22rpx;
  line-height: 1.3;
}

.summary-metric-value {
  display: block;
  margin-top: 7rpx;
  color: #1F1A15;
  font-size: 25rpx;
  font-weight: 800;
  word-break: break-all;
}

.picker-row,
.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #E7D8C5;
  border-radius: var(--radius-md);
  background: var(--color-search-bg);
  color: #1F1A15;
}

.picker-row,
.input {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
}

.textarea {
  min-height: 172rpx;
  padding: 20rpx 22rpx;
}

.application-option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.option-field {
  min-width: 0;
}

.field-label {
  margin-bottom: 8rpx;
  color: #82776B;
  font-size: 23rpx;
  font-weight: 700;
}

.reason-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.reason-count {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8A7A68;
}

.reason-count-warning {
  color: #A23B3B;
}

.detail-reason-head {
  margin-top: 22rpx;
}

.remark-input {
  margin-top: 14rpx;
}

.range-head,
.evidence-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EFE6DA;
}

.item-row:last-child {
  border-bottom: 0;
}

.check {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  border: 2rpx solid #C7AE8B;
  border-radius: 50%;
  color: #A8793A;
  font-weight: 700;
}

.item-selected .check {
  background: var(--color-primary);
  color: #FFFFFF;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-weight: 700;
  color: #1F1A15;
}

.qty-input {
  width: 104rpx;
  height: 58rpx;
  text-align: center;
  border: 1rpx solid #E7D8C5;
  border-radius: 999rpx;
  background: #FFFCF7;
}

.refund-block {
  margin-top: 18rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EFE6DA;
}

.amount-limit {
  flex-shrink: 0;
  color: #8A6A43;
  font-size: 23rpx;
  font-weight: 800;
}

.amount-tip {
  margin-top: 12rpx;
}

.mini-btn {
  min-width: 116rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.image-box {
  position: relative;
  aspect-ratio: 1;
}

.evidence-image {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md);
  background: var(--color-muted-bg);
}

.remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 38rpx;
  height: 38rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  color: #FFFFFF;
  background: rgba(70, 54, 36, 0.76);
}

.after-sale-submit-shell {
  margin: 20rpx 0 48rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.82);
  border-radius: 30rpx;
  background: rgba(255, 253, 249, 0.94);
  box-shadow: 0 18rpx 46rpx rgba(64, 48, 30, 0.14), inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
}

.submit-btn {
  width: 100%;
  margin: 0;
}

.submit-note {
  margin-top: 12rpx;
  color: #82776B;
  font-size: 23rpx;
  line-height: 1.35;
  text-align: center;
}

@media (max-width: 360px) {
  .after-sale-header {
    flex-direction: column;
  }

  .after-sale-state-pill {
    margin-top: 0;
  }

  .application-option-grid {
    grid-template-columns: 1fr;
  }

  .summary-metric {
    padding: 0 8rpx;
  }

  .summary-metric-value {
    font-size: 23rpx;
  }
}
