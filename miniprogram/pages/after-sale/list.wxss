.after-sale-list-page {
  background: #F8F4ED;
}

.after-list-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 10rpx;
  margin-bottom: 18rpx;
}

.section-kicker {
  color: #8A6A43;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
}

.page-title {
  margin-top: 8rpx;
  color: #1F1A15;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.08;
}

.page-desc {
  margin-top: 10rpx;
  color: #82776B;
  font-size: 25rpx;
  line-height: 1.5;
}

.after-count-pill {
  flex: 0 0 auto;
  min-width: 96rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #FFFDF9;
  border: 1rpx solid #E6D8C7;
  color: #7B6245;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(86, 62, 34, 0.06);
}

.after-card {
  position: relative;
  overflow: hidden;
  padding: 22rpx 22rpx 20rpx 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(230, 216, 199, 0.92);
  background: linear-gradient(180deg, #FFFDF9 0%, #FCF7EF 100%);
  box-shadow: 0 10rpx 24rpx rgba(86, 62, 34, 0.07);
}

.after-card-accent {
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: #B99C74;
}

.after-card-head {
  align-items: flex-start;
  gap: 14rpx;
}

.after-no {
  flex: 1;
  min-width: 0;
  color: #1F1A15;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.status-pill {
  flex: 0 0 auto;
  max-width: 220rpx;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #F3E7D6;
  color: #7B6245;
  font-size: 22rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-no,
.created {
  margin-top: 10rpx;
  color: #82776B;
  font-size: 23rpx;
  line-height: 1.45;
}

.after-summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.summary-item {
  min-width: 0;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #F8F1E8;
  border: 1rpx solid #EFE6DA;
}

.summary-label {
  color: #A79B8B;
  font-size: 21rpx;
  line-height: 1.35;
}

.summary-value {
  margin-top: 6rpx;
  color: #1F1A15;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EFE6DA;
  align-items: flex-end;
}

.price {
  flex: 0 0 auto;
  color: #9A2D2D;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}
