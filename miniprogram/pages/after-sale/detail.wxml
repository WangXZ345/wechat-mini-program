<view class="page page-enter after-sale-detail-page">
  <ui-skeleton wx:if="{{loading}}" count="{{3}}" showThumb="{{false}}"></ui-skeleton>
  <ui-empty wx:if="{{initialized && !loading && !afterSale}}" icon="!" title="售后单不存在" description="请返回售后列表重新打开"></ui-empty>

  <block wx:if="{{!loading && afterSale}}">
    <view class="after-sale-header">
      <view class="after-sale-header-copy">
        <view class="eyebrow">售后详情</view>
        <view class="page-title">处理进度</view>
        <view class="muted">进度以客服审核和财务退款确认为准</view>
      </view>
      <view class="after-sale-state-pill">{{afterSale.statusText}}</view>
    </view>

    <view class="card section after-sale-status-card">
      <view class="status-card-head">
        <view>
          <view class="step-label">售后单</view>
          <view class="subtitle">{{afterSale.afterSaleNo}}</view>
          <view class="muted order-no">订单号 {{afterSale.orderNo}}</view>
        </view>
        <view class="refund-summary">
          <view class="muted">申请金额</view>
          <view class="price">￥{{afterSale.requestedRefundText}}</view>
          <view class="refund-status">{{afterSale.refundText}}</view>
        </view>
      </view>
      <view class="progress-strip">
        <view class="progress-node active">
          <view class="progress-dot"></view>
          <view class="progress-copy">已提交</view>
        </view>
        <view class="progress-line"></view>
        <view class="progress-node active">
          <view class="progress-dot"></view>
          <view class="progress-copy">{{afterSale.statusText}}</view>
        </view>
        <view class="progress-line"></view>
        <view class="progress-node">
          <view class="progress-dot"></view>
          <view class="progress-copy">{{afterSale.refundText}}</view>
        </view>
      </view>
      <view class="status-metric-grid">
        <view class="status-metric">
          <view class="metric-label">售后类型</view>
          <view class="metric-value">{{afterSale.typeText}}</view>
        </view>
        <view class="status-metric">
          <view class="metric-label">售后原因</view>
          <view class="metric-value">{{afterSale.reasonText}}</view>
        </view>
        <view class="status-metric">
          <view class="metric-label">审批金额</view>
          <view class="metric-value">￥{{afterSale.approvedRefundText}}</view>
        </view>
        <view class="status-metric">
          <view class="metric-label">实退金额</view>
          <view class="metric-value">￥{{afterSale.actualRefundText}}</view>
        </view>
      </view>
    </view>

    <view class="card section after-sale-card">
      <view class="section-head">
        <view>
          <view class="section-kicker">申请说明</view>
          <view class="subtitle">申请内容</view>
        </view>
        <view wx:if="{{afterSale.evidenceImages.length}}" class="section-count">{{afterSale.evidenceImages.length}} 张凭证</view>
      </view>
      <view class="reason-text">{{afterSale.customerReasonDetail}}</view>
      <view wx:if="{{afterSale.customerRemark}}" class="muted remark">备注：{{afterSale.customerRemark}}</view>
      <view class="image-grid" wx:if="{{afterSale.evidenceImages.length}}">
      <image wx:for="{{afterSale.evidenceImages}}" wx:key="*this" src="{{item}}" mode="aspectFit" lazy-load="true"></image>
      </view>
    </view>

    <view class="card section after-sale-card">
      <view class="section-head">
        <view>
          <view class="section-kicker">商品明细</view>
          <view class="subtitle">售后商品</view>
        </view>
        <view class="section-count">{{afterSale.returnItems.length}} 项</view>
      </view>
      <view wx:for="{{afterSale.returnItems}}" wx:key="productId" class="item-line">
        <view class="row between">
          <view class="item-name">{{item.productName}}</view>
          <view class="price">￥{{item.refundableAmountText}}</view>
        </view>
        <view class="muted">{{item.specification || "无规格"}}｜{{item.productionDate || "无生产日期"}}</view>
        <view class="muted">申请 {{item.returnQuantity}} / 已购 {{item.orderedQuantity}}，单价 ￥{{item.unitPriceText}}</view>
      </view>
    </view>

    <view class="card section after-sale-card">
      <view class="section-head">
        <view>
          <view class="section-kicker">审核结果</view>
          <view class="subtitle">审核信息</view>
        </view>
      </view>
      <view class="kv"><text>审核时间</text><text>{{afterSale.reviewedAtText || "待审核"}}</text></view>
      <view class="kv"><text>审核意见</text><text>{{afterSale.adminReviewRemark || "暂无"}}</text></view>
      <view wx:if="{{afterSale.rejectReason}}" class="kv"><text>拒绝原因</text><text>{{afterSale.rejectReason}}</text></view>
    </view>

    <view class="card section after-sale-card">
      <view class="section-head">
        <view>
          <view class="section-kicker">退货处理</view>
          <view class="subtitle">退货物流</view>
        </view>
      </view>
      <block wx:if="{{afterSale.afterSaleStatus === 'waiting_return'}}">
        <view class="logistics-panel">
          <view class="muted logistics-hint">请填写退货快递信息，提交后客服会继续处理售后进度。</view>
          <input class="input" value="{{shippingCompany}}" data-field="shippingCompany" bindinput="onInput" placeholder="快递公司" />
          <input class="input" value="{{trackingNo}}" data-field="trackingNo" bindinput="onInput" placeholder="快递单号" />
          <button class="btn btn-primary action-full" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitLogistics">提交退货物流</button>
        </view>
      </block>
      <block wx:else>
        <view class="kv"><text>快递公司</text><text>{{afterSale.returnLogistics.shippingCompany || "暂无"}}</text></view>
        <view class="kv"><text>快递单号</text><text>{{afterSale.returnLogistics.trackingNo || "暂无"}}</text></view>
      </block>
    </view>

    <view class="card section after-sale-card">
      <view class="section-head">
        <view>
          <view class="section-kicker">处理记录</view>
          <view class="subtitle">时间线</view>
        </view>
        <view wx:if="{{logs.length}}" class="section-count">{{logs.length}} 条</view>
      </view>
      <view wx:for="{{logs}}" wx:key="_id" class="timeline-row">
        <view class="dot"></view>
        <view class="timeline-main">
          <view class="timeline-title">{{item.remark || item.action}}</view>
          <view class="muted">{{item.createdAtText}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
