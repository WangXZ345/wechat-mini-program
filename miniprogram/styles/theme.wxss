:root,
page {
  --color-primary: #B99C74;
  --color-primary-deep: #9A856B;
  --color-primary-active: #A8793A;
  --color-primary-light: #C7AE8B;
  --color-primary-shadow: #8E7456;
  --color-nav-deep: #9A856B;
  --color-nav-light: #C7AE8B;
  --color-action: #1F1914;
  --color-action-pressed: #120F0C;
  --color-action-text: #FFFDF9;
  --color-bg: #F8F4ED;
  --color-bg-deep: #F3E9DA;
  --color-card: #FFFDF9;
  --color-card-warm: #FCF7EF;
  --color-search-bg: #FFFCF7;
  --color-secondary-bg: #EFE6DA;
  --color-tag-bg: #F3E7D6;
  --color-tag-text: #74532E;
  --color-text-main: #1F1A15;
  --color-text-secondary: #82776B;
  --color-text-muted: #A79B8B;
  --color-border: #E6D8C7;
  --color-border-light: #F0E5D7;
  --color-danger: #A94442;
  --color-warning: #B7793A;
  --color-success: #5E7C58;
  --color-info: #456C81;
  --color-money: #9A2D2D;
  --color-success-bg: #E9F0E1;
  --color-success-text: #566F49;
  --color-warning-bg: #FFF7EA;
  --color-warning-text: #8A6A43;
  --color-danger-bg: #F6E5DE;
  --color-danger-text: #A94442;
  --color-muted-bg: #EFE6DA;
  --color-white: #FFFDF9;
  --color-overlay: rgba(31, 26, 21, 0.36);
  --color-tabbar-bg: #FFFDF9;
  --color-tabbar-border: #E8DCCB;
  --color-tabbar-text: #6F675E;
  --color-tabbar-muted: #9A9085;
  --color-tabbar-active: #74532E;
  --color-tabbar-active-bg: #F3E7D6;
  --color-tabbar-badge: #A92C2C;
  --color-input-focus: #D8C1A1;
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --radius-xxl: 48rpx;
  --radius-pill: 999rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 20rpx;
  --space-lg: 28rpx;
  --space-xl: 40rpx;
  --shadow-card: 0 12rpx 32rpx rgba(142, 116, 86, 0.10);
  --shadow-float: 0 20rpx 48rpx rgba(142, 116, 86, 0.16);
  --shadow-soft: 0 8rpx 20rpx rgba(142, 116, 86, 0.08);
  --shadow-button: 0 10rpx 22rpx rgba(142, 116, 86, 0.18);
  --shadow-tabbar: 0 -8rpx 28rpx rgba(120, 95, 62, 0.08);
  --shadow-inset: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
  --motion-press: 120ms;
  --motion-fast: 160ms;
  --motion-normal: 220ms;
  --motion-slow: 280ms;
  --motion-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --motion-ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --motion-stagger-step: 24ms;
  --motion-stagger-max: 120ms;
  --tabbar-height: 98rpx;
  --tabbar-shell-height: 140rpx;
  --space-page: 24rpx;
  --space-card: 24rpx;
}
