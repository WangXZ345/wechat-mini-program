.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% -8%, rgba(255, 253, 249, 0.92) 0, rgba(255, 253, 249, 0) 300rpx),
    linear-gradient(180deg, #F9F5EE 0%, var(--color-bg) 42%, var(--color-bg-deep) 100%);
}

.page-safe-bottom {
  padding-bottom: 160rpx;
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.page-with-tabbar {
  padding-bottom: 168rpx;
  padding-bottom: calc(168rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.stack-sm > view,
.stack-sm > button,
.stack-sm > input {
  margin-top: 12rpx;
}

.muted {
  color: var(--color-text-muted);
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--color-text-main);
  line-height: 1.25;
}

.subtitle {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-main);
  line-height: 1.35;
}

.price,
.money {
  color: var(--color-money);
  font-weight: 800;
}

.titanium-header {
  margin: -24rpx -24rpx 24rpx;
  padding: 32rpx 24rpx;
  background:
    linear-gradient(135deg, rgba(255, 253, 249, 0.32), rgba(255, 253, 249, 0)),
    linear-gradient(135deg, var(--color-nav-light), var(--color-nav-deep));
  color: var(--color-text-main);
  box-shadow: 0 12rpx 30rpx rgba(142, 116, 86, 0.14);
}

.titanium-header .muted {
  color: rgba(31, 26, 21, 0.68);
}
