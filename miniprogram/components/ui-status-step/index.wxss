.status-steps {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8rpx;
}

.status-step {
  position: relative;
  flex: 1;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.status-step::before {
  content: "";
  position: absolute;
  left: -50%;
  right: 50%;
  top: 13rpx;
  height: 2rpx;
  background: var(--color-border);
}

.status-step:first-child::before {
  display: none;
}

.status-step.is-active {
  color: var(--color-text-main);
  font-weight: 700;
}

.status-step.is-active::before {
  background: var(--color-primary);
}

.status-dot {
  width: 28rpx;
  height: 28rpx;
  margin: 0 auto 10rpx;
  border-radius: 50%;
  background: var(--color-border);
}

.status-step.is-active .status-dot {
  background: var(--color-primary);
}
